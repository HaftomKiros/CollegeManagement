<Page x:Class="CollegeManagementWPF.Views.PlaceholderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1B3E" Offset="0"/>
            <GradientStop Color="#0A1628" Offset="0.5"/>
            <GradientStop Color="#071020" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Width="70" Height="70" CornerRadius="16"
                    HorizontalAlignment="Center" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A2F6E" Offset="0"/>
                        <GradientStop Color="#0F2050" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="🏗" FontSize="32"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="TxtName"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White" FontFamily="Segoe UI"
                       HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <TextBlock Text="This module is coming soon."
                       FontSize="12" Foreground="#3A5A8A"
                       FontFamily="Segoe UI" HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</Page>