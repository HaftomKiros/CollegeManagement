<Page x:Class="CollegeManagementWPF.Views.RolesPermissionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:CollegeManagementWPF.Views">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Background="Transparent">
        <StackPanel Margin="28,22,28,28">

            <!-- Page header banner -->
            <Border CornerRadius="16" Padding="28,22" Margin="0,0,0,24" BorderThickness="1">
                <Border.BorderBrush><SolidColorBrush Color="#7C3AED"/></Border.BorderBrush>
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A0A3A" Offset="0"/>
                        <GradientStop Color="#0D0720" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Roles &amp; Permissions" FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                        <TextBlock Text="Define access levels by setting the Priority field when creating accounts." FontSize="11.5" Foreground="#9977BB" FontFamily="Segoe UI" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="1" Width="54" Height="54" CornerRadius="14" Background="#3A0A7A" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8D7;" FontFamily="Segoe MDL2 Assets" FontSize="26" Foreground="#E879F9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>

            <!-- Three role cards -->
            <UniformGrid Rows="1" Columns="3" Margin="0,0,0,24">

                <!-- Super Admin -->
                <Border CornerRadius="14" Padding="20,18" Margin="0,0,12,0" BorderThickness="1">
                    <Border.BorderBrush><SolidColorBrush Color="#7C3AED"/></Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#1A0A3A" Offset="0"/><GradientStop Color="#0D051E" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Width="50" Height="50" CornerRadius="14" Background="#3A0A7A" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="&#xE728;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#E879F9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Super Admin" FontSize="16" FontWeight="Bold" Foreground="#E879F9" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                        <Border CornerRadius="10" Padding="8,3" Background="#3A0A7A" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="Priority: 1" Foreground="#C084FC" FontSize="10.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        </Border>
                        <Border Height="1" Background="#3A1A6A" Margin="0,0,0,12"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#A855F7" Margin="0,0,8,0"/><TextBlock Text="Full system access" Foreground="#BB99DD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#A855F7" Margin="0,0,8,0"/><TextBlock Text="Manage all accounts" Foreground="#BB99DD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#A855F7" Margin="0,0,8,0"/><TextBlock Text="All student modules" Foreground="#BB99DD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#A855F7" Margin="0,0,8,0"/><TextBlock Text="Reports &amp; Analytics" Foreground="#BB99DD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="✓" Foreground="#A855F7" Margin="0,0,8,0"/><TextBlock Text="System configuration" Foreground="#BB99DD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Admin -->
                <Border CornerRadius="14" Padding="20,18" Margin="0,0,12,0" BorderThickness="1">
                    <Border.BorderBrush><SolidColorBrush Color="#1D4ED8"/></Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D1F4A" Offset="0"/><GradientStop Color="#060E28" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Width="50" Height="50" CornerRadius="14" Background="#1A3A7A" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Admin" FontSize="16" FontWeight="Bold" Foreground="#60A5FA" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                        <Border CornerRadius="10" Padding="8,3" Background="#1A3A7A" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="Priority: 2" Foreground="#93C5FD" FontSize="10.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        </Border>
                        <Border Height="1" Background="#1A3A6A" Margin="0,0,0,12"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#3B82F6" Margin="0,0,8,0"/><TextBlock Text="Student management" Foreground="#8AADDD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#3B82F6" Margin="0,0,8,0"/><TextBlock Text="Department &amp; courses" Foreground="#8AADDD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#3B82F6" Margin="0,0,8,0"/><TextBlock Text="Reports generation" Foreground="#8AADDD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#3B82F6" Margin="0,0,8,0"/><TextBlock Text="Library management" Foreground="#8AADDD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="✗" Foreground="#EF4444" Margin="0,0,8,0"/><TextBlock Text="Cannot manage accounts" Foreground="#8AADDD" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Viewer -->
                <Border CornerRadius="14" Padding="20,18" BorderThickness="1">
                    <Border.BorderBrush><SolidColorBrush Color="#15803D"/></Border.BorderBrush>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0D2A1A" Offset="0"/><GradientStop Color="#06150D" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel>
                        <Border Width="50" Height="50" CornerRadius="14" Background="#0D3A1A" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="&#xE890;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Viewer" FontSize="16" FontWeight="Bold" Foreground="#4ADE80" FontFamily="Segoe UI" Margin="0,0,0,4"/>
                        <Border CornerRadius="10" Padding="8,3" Background="#0D3A1A" HorizontalAlignment="Left" Margin="0,0,0,12">
                            <TextBlock Text="Priority: 3+" Foreground="#86EFAC" FontSize="10.5" FontWeight="SemiBold" FontFamily="Segoe UI"/>
                        </Border>
                        <Border Height="1" Background="#1A4A2A" Margin="0,0,0,12"/>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#22C55E" Margin="0,0,8,0"/><TextBlock Text="View all records" Foreground="#6AAA8A" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✓" Foreground="#22C55E" Margin="0,0,8,0"/><TextBlock Text="Generate reports" Foreground="#6AAA8A" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✗" Foreground="#EF4444" Margin="0,0,8,0"/><TextBlock Text="Cannot add/edit records" Foreground="#6AAA8A" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6"><TextBlock Text="✗" Foreground="#EF4444" Margin="0,0,8,0"/><TextBlock Text="Cannot delete records" Foreground="#6AAA8A" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                            <StackPanel Orientation="Horizontal"><TextBlock Text="✗" Foreground="#EF4444" Margin="0,0,8,0"/><TextBlock Text="Cannot manage accounts" Foreground="#6AAA8A" FontFamily="Segoe UI" FontSize="11.5"/></StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- How to set priority info card -->
            <Border CornerRadius="14" Padding="24,18" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="12" Background="#1A3A6A" VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#4A9AEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="How to assign a role" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                        <TextBlock Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" FontSize="11.5" TextWrapping="Wrap">
                            Go to <Bold>Manage Accounts</Bold>, create or select an account, and set the <Bold>Priority</Bold> field to 1 (Super Admin), 2 (Admin), or 3+ (Viewer). Lower number means higher access level. Passwords must match when saving or updating.
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
