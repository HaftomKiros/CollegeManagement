<Page x:Class="CollegeManagementWPF.Views.DashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1B3E" Offset="0"/>
            <GradientStop Color="#0A1628" Offset="0.5"/>
            <GradientStop Color="#071020" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24">
            <Border CornerRadius="12" Padding="26,20" Margin="0,0,0,24" BorderThickness="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#1A2F6E" Offset="0"/>
                        <GradientStop Color="#0D0B1E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.BorderBrush><SolidColorBrush Color="#2E1A5E"/></Border.BorderBrush>
                <StackPanel>
                    <TextBlock Text="Welcome back, Administrator" FontSize="19" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Here is what is happening at Wukro St. Mary College today." FontSize="11" Foreground="#8877AA" FontFamily="Segoe UI" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <UniformGrid Rows="1" Columns="4" Margin="0,0,0,24">
                <Border Margin="0,0,10,0" CornerRadius="10" Padding="18,14" BorderThickness="1" BorderBrush="#1A3A7A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D1F4A" Offset="0"/><GradientStop Color="#0A1635" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel>
                        <TextBlock Text="Total Students" FontSize="11" Foreground="#5577AA" FontFamily="Segoe UI"/>
                        <TextBlock Text="Loading..." FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="5,0" CornerRadius="10" Padding="18,14" BorderThickness="1" BorderBrush="#1A5A2A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D2A1A" Offset="0"/><GradientStop Color="#071A10" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel>
                        <TextBlock Text="Courses" FontSize="11" Foreground="#337755" FontFamily="Segoe UI"/>
                        <TextBlock Text="Loading..." FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="5,0" CornerRadius="10" Padding="18,14" BorderThickness="1" BorderBrush="#5A3A0A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A1E08" Offset="0"/><GradientStop Color="#1A1205" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel>
                        <TextBlock Text="Instructors" FontSize="11" Foreground="#7A5A22" FontFamily="Segoe UI"/>
                        <TextBlock Text="Loading..." FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
                <Border Margin="10,0,0,0" CornerRadius="10" Padding="18,14" BorderThickness="1" BorderBrush="#5A1A1A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A0D0D" Offset="0"/><GradientStop Color="#1A0707" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel>
                        <TextBlock Text="Fees Pending" FontSize="11" Foreground="#7A3333" FontFamily="Segoe UI"/>
                        <TextBlock Text="Loading..." FontSize="22" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </UniformGrid>
            <TextBlock Text="Quick Access" FontSize="13" FontWeight="SemiBold" Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,12"/>
            <UniformGrid Rows="2" Columns="3">
                <Border Margin="0,0,8,8" CornerRadius="8" Padding="14" Cursor="Hand" BorderThickness="1" BorderBrush="#2A2A5A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A1A3A" Offset="0"/><GradientStop Color="#0D1128" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Register Student" FontSize="12" Foreground="#CCDDFF" FontFamily="Segoe UI" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <Border Margin="4,0,4,8" CornerRadius="8" Padding="14" Cursor="Hand" BorderThickness="1" BorderBrush="#1A4A2A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D2A1A" Offset="0"/><GradientStop Color="#071A10" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Enter Marks" FontSize="12" Foreground="#AAFFCC" FontFamily="Segoe UI" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <Border Margin="8,0,0,8" CornerRadius="8" Padding="14" Cursor="Hand" BorderThickness="1" BorderBrush="#4A3A0A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A1E08" Offset="0"/><GradientStop Color="#1A1205" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Attendance Sheet" FontSize="12" Foreground="#FFE8AA" FontFamily="Segoe UI" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <Border Margin="0,0,8,0" CornerRadius="8" Padding="14" Cursor="Hand" BorderThickness="1" BorderBrush="#4A1A1A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#2A0D0D" Offset="0"/><GradientStop Color="#1A0707" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Student Fees" FontSize="12" Foreground="#FFCCCC" FontFamily="Segoe UI" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <Border Margin="4,0" CornerRadius="8" Padding="14" Cursor="Hand" BorderThickness="1" BorderBrush="#1A3A4A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D1E2A" Offset="0"/><GradientStop Color="#07121A" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Manage Courses" FontSize="12" Foreground="#AAEEFF" FontFamily="Segoe UI" VerticalAlignment="Center"/></StackPanel>
                </Border>
                <Border Margin="8,0,0,0" CornerRadius="8" Padding="14" Cursor="Hand" BorderThickness="1" BorderBrush="#3A1A4A">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A0D2A" Offset="0"/><GradientStop Color="#10071A" Offset="1"/></LinearGradientBrush></Border.Background>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="COC Records" FontSize="12" Foreground="#DDAAFF" FontFamily="Segoe UI" VerticalAlignment="Center"/></StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</Page>
