<Page x:Class="CollegeManagementWPF.Views.GradeConfigPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>
    <Page.Resources>
        <Style x:Key="FL" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource RegLabelFg}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="WI" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="TC" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
        <Style x:Key="AB" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Page.Resources>

    <Grid Margin="24,16,24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" CornerRadius="14" Padding="24,16" Margin="0,0,0,16" BorderThickness="1">
            <Border.BorderBrush><SolidColorBrush Color="#3B82F6"/></Border.BorderBrush>
            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#1A2F6E" Offset="0"/><GradientStop Color="#0D0B3A" Offset="1"/></LinearGradientBrush></Border.Background>
            <StackPanel Orientation="Horizontal">
                <Border Width="36" Height="36" CornerRadius="10" Background="#1A3A6B" Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="DataArea24" FontSize="18" Foreground="#60A5FA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Grade Configuration" FontSize="18" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Configure Raw Mark ranges, Letter Grades and Grade Point Values" FontSize="11" Foreground="#9988BB" FontFamily="Segoe UI"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Entry card -->
        <Border Grid.Row="1" CornerRadius="12" Padding="20,16" Margin="0,0,0,14" BorderThickness="1">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel>
                <TextBlock Text="Add / Edit Grade Rule" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" Margin="0,0,0,12"/>
                <UniformGrid Rows="1" Columns="4" Margin="0,0,0,12">
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Min Score" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtMin" Style="{StaticResource WI}" ToolTip="e.g. 95"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Max Score" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtMax" Style="{StaticResource WI}" ToolTip="Upper bound. For A+, enter 100."/>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Letter Grade" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtLetter" Style="{StaticResource WI}" ToolTip="e.g. A+"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Grade Points Value" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtPoints" Style="{StaticResource WI}" ToolTip="e.g. 4 or 3.75"/>
                    </StackPanel>
                </UniformGrid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Save"   Click="BtnSave_Click"   Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                    <Button Content="Update" Click="BtnUpdate_Click" Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#1A9944"/></Button.Background></Button>
                    <Button Content="Delete" Click="BtnDelete_Click" Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#CC2222"/></Button.Background></Button>
                    <Button Content="Clear"  Click="BtnClear_Click"  Style="{StaticResource AB}" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
                    <Button Content="↺ Load Defaults" Click="BtnDefaults_Click" Style="{StaticResource AB}" Margin="16,0,0,0"><Button.Background><SolidColorBrush Color="#335577"/></Button.Background></Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Grid -->
        <Border Grid.Row="2" CornerRadius="10" BorderThickness="1" ClipToBounds="True">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
            <DataGrid x:Name="Grid1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      Background="Transparent" RowBackground="{DynamicResource TableRowBg}"
                      BorderThickness="0" GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{DynamicResource RegInputBorder}"
                      ColumnHeaderHeight="34" RowHeight="32" FontSize="12" FontFamily="Segoe UI"
                      Foreground="{DynamicResource TableRowFg}"
                      SelectionChanged="Grid1_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TableHeaderFg}"/>
                        <Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/>
                        <Setter Property="Background" Value="{DynamicResource TableRowBg}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TableRowHoverBg}"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Raw Mark Range"   Binding="{Binding range_label}"   Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Letter Grade"     Binding="{Binding letter_grade}"  Width="120"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Grade Points"     Binding="{Binding grade_points}"  Width="120"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Min Score"        Binding="{Binding min_score}"     Width="100"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Max Score"        Binding="{Binding max_score}"     Width="100"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Page>
