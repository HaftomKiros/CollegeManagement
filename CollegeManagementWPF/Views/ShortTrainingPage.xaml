<Page x:Class="CollegeManagementWPF.Views.ShortTrainingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/><GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/></LinearGradientBrush></Page.Background>
    <Page.Resources>
        <Style x:Key="FL" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource RegLabelFg}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="WI" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DD" TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid><ToggleButton BorderThickness="0" Background="Transparent" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderThickness="0"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,24,0" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#4A7ACC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/></Grid></Border><Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" Placement="Bottom" PopupAnimation="Slide"><Border Background="{DynamicResource RegInputBg}" BorderBrush="{DynamicResource RegInputBorder}" BorderThickness="1" CornerRadius="0,0,6,6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200"><ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter><Style.Resources><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Style.Resources></Style>
        <Style x:Key="TC" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
        <Style x:Key="AB" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="16,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Page.Resources>

    <Grid Margin="16,10,16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="210"/></Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Entry card row 1 -->
            <Border Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,6" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <UniformGrid Rows="1" Columns="5">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Student ID" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtStudentId" Style="{StaticResource WI}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Full Name" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtFullName" Style="{StaticResource WI}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Sex" Style="{StaticResource FL}"/>
                        <ComboBox x:Name="CmbSex" Style="{StaticResource DD}">
                            <ComboBoxItem Content="Male"/>
                            <ComboBoxItem Content="Female"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Occupational Title" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtOccupation" Style="{StaticResource WI}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Entry Year" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtEntryYear" Style="{StaticResource WI}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Entry card row 2 -->
            <Border Grid.Row="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <UniformGrid Rows="1" Columns="4">
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Training Round Number" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtTrainingRound" Style="{StaticResource WI}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Admission Type" Style="{StaticResource FL}"/>
                        <ComboBox x:Name="CmbAdmType" Style="{StaticResource DD}">
                            <ComboBoxItem Content="Regular" IsSelected="True"/>
                            <ComboBoxItem Content="Extension"/>
                            <ComboBoxItem Content="Distance"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,8,0">
                        <TextBlock Text="Duration of Training" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtDuration" Style="{StaticResource WI}"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Mobile Number" Style="{StaticResource FL}"/>
                        <TextBox x:Name="TxtMobile" Style="{StaticResource WI}"/>
                    </StackPanel>
                </UniformGrid>
            </Border>

            <!-- Action buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button x:Name="BtnSave"   Content="Save"   Click="BtnSave_Click"   Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                <Button x:Name="BtnUpdate" Content="Update" Click="BtnUpdate_Click" Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#1A9944"/></Button.Background></Button>
                <Button x:Name="BtnDelete" Content="Delete" Click="BtnDelete_Click" Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#CC2222"/></Button.Background></Button>
                <Button x:Name="BtnClear"  Content="Clear"  Click="BtnClear_Click"  Style="{StaticResource AB}" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
            </StackPanel>

            <!-- Quick filter -->
            <Border Grid.Row="3" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Filter:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RegLabelFg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtFilter" Style="{StaticResource WI}" Width="200" Height="30" TextChanged="TxtFilter_Changed"/>
                    <Button Content="Reset" Click="BtnReset_Click" Style="{StaticResource AB}" Height="30" Padding="12,0" Margin="6,0,0,0" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Grid Grid.Row="4">
                <Border CornerRadius="10" BorderThickness="1" ClipToBounds="True">
                    <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                    <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                    <DataGrid x:Name="Grid1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              Background="Transparent" RowBackground="{DynamicResource TableRowBg}"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource RegInputBorder}"
                              ColumnHeaderHeight="34" RowHeight="30" FontSize="11.5" FontFamily="Segoe UI"
                              Foreground="{DynamicResource TableRowFg}" SelectionChanged="Grid1_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/><Setter Property="Foreground" Value="{DynamicResource TableHeaderFg}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/></Style></DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="Background" Value="{DynamicResource TableRowBg}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TableRowHoverBg}"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
                        <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="#"                Binding="{Binding _RowNo}"           Width="38"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Student ID"       Binding="{Binding student_id}"       Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Name"             Binding="{Binding full_name}"        Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Sex"              Binding="{Binding sex}"              Width="50"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Occupation"       Binding="{Binding occupational_title}" Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Entry Year"       Binding="{Binding entry_year}"       Width="80"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Round No."        Binding="{Binding training_round}"   Width="70"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Adm Type"         Binding="{Binding admission_type}"   Width="80"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Duration"         Binding="{Binding duration}"         Width="70"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Mobile"           Binding="{Binding mobile_number}"    Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="10">
                    <Border.Background><SolidColorBrush Color="#A0000000"/></Border.Background>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44"/>
                        <TextBlock Text="Loading..." Foreground="White" FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Filter panel -->
        <Border Grid.Column="1" CornerRadius="12" Padding="14,16" BorderThickness="1" VerticalAlignment="Top">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Filter By" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI"/>
                </StackPanel>
                <Border Height="1" Margin="0,0,0,10"><Border.Background><DynamicResource ResourceKey="RegInputBorder"/></Border.Background></Border>

                <TextBlock Text="Entry Year" Style="{StaticResource FL}"/>
                <TextBox x:Name="TxtFYear" Style="{StaticResource WI}" Margin="0,0,0,8"/>

                <TextBlock Text="Training Round No." Style="{StaticResource FL}"/>
                <TextBox x:Name="TxtFRound" Style="{StaticResource WI}" Margin="0,0,0,8"/>

                <TextBlock Text="Duration of Training" Style="{StaticResource FL}"/>
                <TextBox x:Name="TxtFDuration" Style="{StaticResource WI}" Margin="0,0,0,8"/>

                <TextBlock Text="Occupational Title" Style="{StaticResource FL}"/>
                <TextBox x:Name="TxtFOccupation" Style="{StaticResource WI}" Margin="0,0,0,8"/>

                <TextBlock Text="Gender" Style="{StaticResource FL}"/>
                <ComboBox x:Name="CmbFSex" Style="{StaticResource DD}" Margin="0,0,0,8">
                    <ComboBoxItem Content="(All)" IsSelected="True"/>
                    <ComboBoxItem Content="Male"/>
                    <ComboBoxItem Content="Female"/>
                </ComboBox>

                <TextBlock Text="Adm Type" Style="{StaticResource FL}"/>
                <ComboBox x:Name="CmbFAdmType" Style="{StaticResource DD}" Margin="0,0,0,8">
                    <ComboBoxItem Content="(All)" IsSelected="True"/>
                    <ComboBoxItem Content="Regular"/>
                    <ComboBoxItem Content="Extension"/>
                    <ComboBoxItem Content="Distance"/>
                </ComboBox>

                <TextBlock Text="Name" Style="{StaticResource FL}"/>
                <TextBox x:Name="TxtFName" Style="{StaticResource WI}" Margin="0,0,0,8"/>

                <Border Height="1" Margin="0,4,0,10"><Border.Background><DynamicResource ResourceKey="RegInputBorder"/></Border.Background></Border>
                <Button Content="Filter" Click="BtnFilter_Click" Style="{StaticResource AB}" Height="32" Padding="14,0" Margin="0,0,0,6"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                <Button Content="Reset"  Click="BtnFilterReset_Click" Style="{StaticResource AB}" Height="32" Padding="14,0" Margin="0,0,0,10" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
                <Border Height="1" Margin="0,0,0,10"><Border.Background><DynamicResource ResourceKey="RegInputBorder"/></Border.Background></Border>
                <TextBlock Text="Export Report" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                <Button x:Name="BtnPrintReport" Click="BtnPrintReport_Click" Style="{StaticResource AB}" Height="32" Padding="10,0" Margin="0,0,0,6"><Button.Background><SolidColorBrush Color="#335577"/></Button.Background><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="PDF Report" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
                <Button x:Name="BtnExcelReport" Click="BtnExcelReport_Click" Style="{StaticResource AB}" Height="32" Padding="10,0"><Button.Background><SolidColorBrush Color="#1A5A2A"/></Button.Background><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Excel Report" FontFamily="Segoe UI" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>