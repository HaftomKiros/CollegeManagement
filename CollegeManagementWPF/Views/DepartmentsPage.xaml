<Page x:Class="CollegeManagementWPF.Views.DepartmentsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:CollegeManagementWPF.Views">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>
    <Page.Resources>
        <local:AddOneConverter x:Key="AddOneConverter"/>
        <Style x:Key="FL" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource RegLabelFg}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="WI" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="TC" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
        <Style x:Key="AB" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Page.Resources>
    <Grid Margin="16,10,16,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,10" BorderThickness="1">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <UniformGrid Rows="1" Columns="4">
                <StackPanel Margin="0,0,8,0"><TextBlock Text="Dept ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtDeptID" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Dept Name" Style="{StaticResource FL}"/><TextBox x:Name="TxtDeptName" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Program" Style="{StaticResource FL}"/><TextBox x:Name="TxtProgram" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Dept Head" Style="{StaticResource FL}"/><TextBox x:Name="TxtHead" Style="{StaticResource WI}"/></StackPanel>
            </UniformGrid>
        </Border>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
            <Button x:Name="BtnSave"   Content="Save"   Click="BtnSave_Click"   Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
            <Button x:Name="BtnUpdate" Content="Update" Click="BtnUpdate_Click" Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#1A9944"/></Button.Background></Button>
            <Button x:Name="BtnDelete" Content="Delete" Click="BtnDelete_Click" Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#CC2222"/></Button.Background></Button>
            <Button x:Name="BtnClear"  Content="Clear"  Click="BtnClear_Click"  Style="{StaticResource AB}" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
        </StackPanel>
        <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderThickness="1">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBlock Text="Filter:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RegLabelFg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="TxtFilter" Style="{StaticResource WI}" Width="200" Height="30" TextChanged="TxtFilter_Changed"/>
                <Button Click="BtnExportPdf_Click" Height="30" Padding="10,0" Margin="6,0,0,0" Cursor="Hand" BorderThickness="0"><Button.Background><SolidColorBrush Color="#335577"/></Button.Background><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="0,0,3,0"/><TextBlock Text="PDF" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="White" VerticalAlignment="Center"/></StackPanel></Button><Button Click="BtnExportExcel_Click" Height="30" Padding="10,0" Margin="4,0,6,0" Cursor="Hand" BorderThickness="0"><Button.Background><SolidColorBrush Color="#1A5A2A"/></Button.Background><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="11" Foreground="White" VerticalAlignment="Center" Margin="0,0,3,0"/><TextBlock Text="Excel" FontFamily="Segoe UI" FontWeight="Bold" FontSize="10" Foreground="White" VerticalAlignment="Center"/></StackPanel></Button><Button Content="Reset" Click="BtnReset_Click" Style="{StaticResource AB}" Height="30" Padding="12,0" Margin="6,0,0,0" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
            </StackPanel>
        </Border>
        <Grid Grid.Row="3">
            <Border CornerRadius="10" BorderThickness="1" ClipToBounds="True">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                <DataGrid x:Name="Grid1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="Transparent" RowBackground="{DynamicResource TableRowBg}" AlternatingRowBackground="{DynamicResource TableRowBg}"
                          BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RegInputBorder}"
                          ColumnHeaderHeight="34" RowHeight="30" FontSize="11.5" FontFamily="Segoe UI"
                          Foreground="{DynamicResource TableRowFg}" SelectionChanged="Grid1_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/><Setter Property="Foreground" Value="{DynamicResource TableHeaderFg}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/></Style></DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="Background" Value="{DynamicResource TableRowBg}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TableRowHoverBg}"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
                    <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="#" Binding="{Binding _RowNo}" Width="38"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Dept ID" Binding="{Binding dept_id}" Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Name" Binding="{Binding dept_name}" Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Program" Binding="{Binding dept_program}" Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Head" Binding="{Binding dept_head}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
            <Border x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="10"><Border.Background><SolidColorBrush Color="#A0000000"/></Border.Background><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ui:ProgressRing IsIndeterminate="True" Width="44" Height="44"/><TextBlock Text="Loading..." Foreground="White" FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel></Border>
        </Grid>
    </Grid>
</Page>
