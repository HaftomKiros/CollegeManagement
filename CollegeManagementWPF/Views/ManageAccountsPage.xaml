<Page x:Class="CollegeManagementWPF.Views.ManageAccountsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:CollegeManagementWPF.Views">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>
    <Page.Resources>
        <local:AddOneConverter x:Key="AddOneConverter"/>
        <Style x:Key="FL" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource RegLabelFg}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="WI" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="PW" TargetType="PasswordBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="10,6"/></Style>
        <Style x:Key="TC" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
        <Style x:Key="AB" TargetType="Button"><Setter Property="Height" Value="36"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="20,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="9" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Page.Resources>

    <Grid Margin="20,14,20,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT: Form + Table ══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Form card -->
            <Border Grid.Row="0" CornerRadius="14" Padding="24,20" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <StackPanel>
                    <!-- Card header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                        <Border Width="40" Height="40" CornerRadius="10" Background="#2A0A4A" Margin="0,0,12,0">
                            <TextBlock Text="&#xE7EF;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="#E879F9" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Account Management" FontSize="15" FontWeight="Bold"
                                       Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI"/>
                            <TextBlock Text="Create and manage system accounts" FontSize="10.5"
                                       Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>

                        <UniformGrid Rows="2" Columns="2">
                            <StackPanel Margin="0,0,12,12">
                                <TextBlock Text="User Name" Style="{StaticResource FL}"/>
                                <TextBox x:Name="TxtUserName" Style="{StaticResource WI}"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Role" Style="{StaticResource FL}"/>
                                <ComboBox x:Name="CmbRole" Height="34" FontSize="12" FontFamily="Segoe UI"
                                          Background="{DynamicResource RegInputBg}" Foreground="{DynamicResource RegInputFg}"
                                          BorderBrush="{DynamicResource RegInputBorder}" BorderThickness="1"
                                          OverridesDefaultStyle="True">
                                    <ComboBox.Template>
                                        <ControlTemplate TargetType="ComboBox">
                                            <Grid>
                                                <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                                    <Grid>
                                                        <ToggleButton BorderThickness="0" Background="Transparent" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                                            <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderThickness="0"/></ControlTemplate></ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="10,0,24,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#4A7ACC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/>
                                                    </Grid>
                                                </Border>
                                                <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" Placement="Bottom" PopupAnimation="Slide">
                                                    <Border Background="{DynamicResource RegInputBg}" BorderBrush="{DynamicResource RegInputBorder}" BorderThickness="1" CornerRadius="0,0,8,8" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                                        <ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer>
                                                    </Border>
                                                </Popup>
                                            </Grid>
                                        </ControlTemplate>
                                    </ComboBox.Template>
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Background" Value="{DynamicResource RegInputBg}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/>
                                            <Setter Property="Padding" Value="10,7"/>
                                            <Style.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger>
                                                <Trigger Property="IsSelected"  Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Resources>
                                    <ComboBoxItem Content="&#xE728; Super Admin  (Priority 1)" IsSelected="True"/>
                                    <ComboBoxItem Content="&#xE7EF; Admin  (Priority 2)"/>
                                    <ComboBoxItem Content="&#xE890; Viewer  (Priority 3)"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Margin="0,0,12,0">
                                <TextBlock Text="Password" Style="{StaticResource FL}"/>
                                <PasswordBox x:Name="PwdPassword" Style="{StaticResource PW}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Re-enter Password" Style="{StaticResource FL}"/>
                                <PasswordBox x:Name="PwdRePassword" Style="{StaticResource PW}"/>
                            </StackPanel>
                        </UniformGrid>

                    <!-- Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="&#xE74E; Save"   Click="BtnSave_Click"   Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                        <Button Content="&#xE70F; Update" Click="BtnUpdate_Click" Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#1A9944"/></Button.Background></Button>
                        <Button Content="&#xE74D; Delete" Click="BtnDelete_Click" Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#CC2222"/></Button.Background></Button>
                        <Button Content="&#xE75A; Clear"  Click="BtnClear_Click"  Style="{StaticResource AB}" Foreground="#8899AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Grid Grid.Row="2">
                <Border CornerRadius="12" BorderThickness="1" ClipToBounds="True">
                    <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                    <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                    <DataGrid x:Name="Grid1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              Background="Transparent" RowBackground="{DynamicResource TableRowBg}" AlternatingRowBackground="{DynamicResource TableRowBg}"
                              BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RegInputBorder}"
                              ColumnHeaderHeight="36" RowHeight="32" FontSize="12" FontFamily="Segoe UI"
                              Foreground="{DynamicResource TableRowFg}" SelectionChanged="Grid1_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/><Setter Property="Foreground" Value="{DynamicResource TableHeaderFg}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="12,0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/></Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="Background" Value="{DynamicResource TableRowBg}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TableRowHoverBg}"/></Trigger></Style.Triggers></Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="#"         Binding="{Binding _RowNo}"    Width="44"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Admin ID"  Binding="{Binding admin_id}"  Width="80"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="User Name" Binding="{Binding user_name}" Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Password"  Binding="{Binding password}"  Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Role" Binding="{Binding role_name}"  Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="12">
                    <Border.Background><SolidColorBrush Color="#A0000000"/></Border.Background>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44"/>
                        <TextBlock Text="Loading..." Foreground="White" FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- ══ RIGHT: Info panel ══ -->
        <StackPanel Grid.Column="2">

            <!-- Tips card -->
            <Border CornerRadius="14" Padding="20,18" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="15" Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Tips" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI"/>
                    </StackPanel>
                    <TextBlock Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" FontSize="11.5" TextWrapping="Wrap" LineHeight="18">
                        <Run>• Click a row to load its data</Run><LineBreak/>
                        <Run>• Passwords must match to save/update</Run><LineBreak/>
                        <Run>• Lower priority number = higher access</Run><LineBreak/>
                        <Run>• Use Clear to reset the form</Run>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
