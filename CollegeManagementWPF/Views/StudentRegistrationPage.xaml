<Page x:Class="CollegeManagementWPF.Views.StudentRegistrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:CollegeManagementWPF.Views">

    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0A1526" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#060E1C" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Page.Resources>
        <local:AddOneConverter x:Key="AddOneConverter"/>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource RegLabelFg}"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Margin" Value="0,0,0,3"/>
        </Style>
        <Style x:Key="WI" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource RegInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Height" Value="28"/><Setter Property="Padding" Value="6,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DD" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="28"/>
            <Setter Property="BorderBrush" Value="#1E3A6A"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                <Grid>
                                    <ToggleButton BorderThickness="0" Background="Transparent" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderThickness="0"/></ControlTemplate></ToggleButton.Template>
                                    </ToggleButton>
                                    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="7,0,22,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#4A7ACC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0" IsHitTestVisible="False"/>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="{DynamicResource RegInputBg}" BorderBrush="{DynamicResource RegInputBorder}" BorderThickness="1" CornerRadius="0,0,4,4" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200">
                                    <ScrollViewer SnapsToDevicePixels="True"><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="12"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3A6B"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/></Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
        <Style x:Key="TC" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,0"/>
        </Style>
        <Style x:Key="AB" TargetType="Button">
            <Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="14,8,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Form area: left = fields, right = photo -->
        <Border Grid.Row="0" x:Name="FormCard" CornerRadius="10" Padding="14,12" Margin="0,0,0,8"
                BorderThickness="1">
            <Border.BorderBrush><SolidColorBrush x:Name="FormCardBorder" Color="#1E3A6A"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="160"/>
                </Grid.ColumnDefinitions>

                <!-- Left: form fields -->
                <StackPanel Grid.Column="0" Margin="0,0,14,0">
                    <!-- Row 1: 6 fields -->
                    <UniformGrid Rows="1" Columns="6" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Student ID" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtStudID" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="First Name" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtFName" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Father Name" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtMName" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="G/Father Name" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtLName" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Department" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbDeptID" Style="{StaticResource DD}" SelectionChanged="CmbDeptID_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Stream" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbStreamID" Style="{StaticResource DD}"/>
                        </StackPanel>
                    </UniformGrid>
                    <!-- Row 2: 6 fields -->
                    <UniformGrid Rows="1" Columns="6" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Level" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbLevel" Style="{StaticResource DD}">
                                <ComboBoxItem Content="1" IsSelected="True"/>
                                <ComboBoxItem Content="2"/>
                                <ComboBoxItem Content="3"/>
                                <ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Gender" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbSex" Style="{StaticResource DD}">
                                <ComboBoxItem Content="Male" IsSelected="True"/>
                                <ComboBoxItem Content="Female"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Program Type" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbProgram" Style="{StaticResource DD}">
                                <ComboBoxItem Content="TVET" IsSelected="True"/>
                                <ComboBoxItem Content="Regular"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Admission Type" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbAdmType" Style="{StaticResource DD}">
                                <ComboBoxItem Content="Regular" IsSelected="True"/>
                                <ComboBoxItem Content="Extension"/>
                                <ComboBoxItem Content="Distance"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Admission Date" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtAdmYear" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Mobile Number" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtPhone" Style="{StaticResource WI}"/>
                        </StackPanel>
                    </UniformGrid>
                    <!-- Row 3: 6 fields -->
                    <UniformGrid Rows="1" Columns="6" Margin="0,0,0,6">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Wereda" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtWereda" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Kebele" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtKebele" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="GPA Grade 10" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtGpa10" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="GPA Grade 12" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtGpa12" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <!-- Photo File spanning 2 col via Grid trick -->
                        <StackPanel Grid.ColumnSpan="1" Margin="0,0,6,0">
                            <TextBlock Text="Photo File" Style="{StaticResource FL}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtPhoto" Grid.Column="0" Style="{StaticResource WI}" IsReadOnly="True" Margin="0,0,3,0"/>
                                <Button Grid.Column="1" Click="BrowsePhoto_Click" Width="28" Height="28" Cursor="Hand" BorderThickness="0" ToolTip="Browse Photo">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="4" Background="{DynamicResource RegBrowseBg}" BorderThickness="1" BorderBrush="#1E3A6A">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4A9AEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2A5A9A"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Attachment File" Style="{StaticResource FL}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtAttach" Grid.Column="0" Style="{StaticResource WI}" IsReadOnly="True" Margin="0,0,3,0"/>
                                <Button Grid.Column="1" Click="BrowseAttach_Click" Width="28" Height="28" Cursor="Hand" BorderThickness="0" ToolTip="Browse Attachment">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="4" Background="{DynamicResource RegBrowseBg}" BorderThickness="1" BorderBrush="#1E3A6A">
                                                <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#4A9AEE" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#2A5A9A"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Action buttons (Register/Update/Delete/Enroll/Clear) -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <Button x:Name="BtnRegister" Content="Register" Click="BtnRegister_Click" Style="{StaticResource AB}" Margin="0,0,5,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                        <Button x:Name="BtnUpdate"   Content="Update"   Click="BtnUpdate_Click"   Style="{StaticResource AB}" Margin="0,0,5,0"><Button.Background><SolidColorBrush Color="#1A9944"/></Button.Background></Button>
                        <Button x:Name="BtnDelete"   Content="Delete"   Click="BtnDelete_Click"   Style="{StaticResource AB}" Margin="0,0,5,0"><Button.Background><SolidColorBrush Color="#CC2222"/></Button.Background></Button>
                        <Button x:Name="BtnEnroll"   Content="Enroll"   Click="BtnEnroll_Click"   Style="{StaticResource AB}" Margin="0,0,5,0"><Button.Background><SolidColorBrush Color="#8822CC"/></Button.Background></Button>
                        <Button x:Name="BtnClear"    Content="Clear"    Click="BtnClear_Click"    Style="{StaticResource AB}" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
                    </StackPanel>
                    <Border x:Name="MsgBorder" CornerRadius="6" Padding="10,5" Visibility="Collapsed" Margin="0,4,0,0">
                        <TextBlock x:Name="TxtMsg" FontSize="11.5" FontFamily="Segoe UI" HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>

                <!-- Right: photo card + info -->
                <Border Grid.Column="1" x:Name="PhotoCard" CornerRadius="10" BorderThickness="1">
                    <Border.BorderBrush><DynamicResource ResourceKey="RegInputBg"/></Border.BorderBrush>
                    <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                    <StackPanel>

                        <!-- Photo frame -->
                        <Border CornerRadius="8" ClipToBounds="True" Margin="8,8,8,0"
                                Height="148" Background="{DynamicResource RegPhotoBg}"
                                BorderThickness="1" BorderBrush="#1A3A6A">
                            <Grid>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="32"
                                               Foreground="#1E3A6A" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="PhotoPlaceholder" Text="No Photo"
                                               Foreground="{DynamicResource RegPhotoPlaceholder}" FontSize="10.5" FontFamily="Segoe UI"
                                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                                <Image x:Name="ImgPreview" Stretch="UniformToFill" Visibility="Collapsed"/>
                            </Grid>
                        </Border>

                        <!-- Download icons row (icon only, tooltip on hover) -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="8,6,8,0">

                            <!-- Photo download -->
                            <Button Click="DownloadPhoto_Click" Width="36" Height="36" Cursor="Hand"
                                    BorderThickness="0" Background="Transparent" Margin="0,0,8,0">
                                <Button.ToolTip>
                                    <ToolTip Content="Download Photo" FontFamily="Segoe UI" FontSize="11"
                                             Background="#0F1E36" Foreground="White" BorderBrush="#1E3A6A"/>
                                </Button.ToolTip>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource RegInputBorder}" Background="{DynamicResource RegPhotoBg}">
                                            <TextBlock x:Name="ic" Text="&#xE896;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15" Foreground="#4A9AEE"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1A3A6B"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A9AEE"/>
                                                <Setter TargetName="ic" Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Attachment download -->
                            <Button Click="DownloadAttachment_Click" Width="36" Height="36" Cursor="Hand"
                                    BorderThickness="0" Background="Transparent">
                                <Button.ToolTip>
                                    <ToolTip Content="Download Attachment" FontFamily="Segoe UI" FontSize="11"
                                             Background="#0F1E36" Foreground="White" BorderBrush="#1E3A6A"/>
                                </Button.ToolTip>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="bd" CornerRadius="8" BorderThickness="1"
                                                BorderBrush="{DynamicResource RegInputBorder}" Background="{DynamicResource RegPhotoBg}">
                                            <TextBlock x:Name="ic" Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets"
                                                       FontSize="15" Foreground="#4A9AEE"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="Background" Value="#1A3A6B"/>
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A9AEE"/>
                                                <Setter TargetName="ic" Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                        </StackPanel>

                        <!-- Divider -->
                        <Border Height="1" Background="{DynamicResource RegInputBorder}" Margin="8,8,8,0"/>

                        <!-- Collapsible info panel -->
                        <StackPanel Margin="8,4,8,6">
                            <!-- Name always visible + toggle chevron -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="InfoName" Grid.Column="0"
                                           FontSize="10.5" FontWeight="Bold" Foreground="White"
                                           FontFamily="Segoe UI" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                <ToggleButton x:Name="InfoToggle" Grid.Column="1" IsChecked="False"
                                              Cursor="Hand" Width="20" Height="20"
                                              Background="Transparent" BorderThickness="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <TextBlock x:Name="chev" Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                           Foreground="#4A7ACC"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="chev" Property="Text" Value="&#xE70E;"/>
                                                    <Setter TargetName="chev" Property="Foreground" Value="#6A9AEE"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                            <!-- Collapsible details -->
                            <StackPanel Margin="0,3,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked, ElementName=InfoToggle}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock x:Name="InfoDept"   FontSize="10" Foreground="#4A7ACC" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                                <TextBlock x:Name="InfoEnroll" FontSize="10" Foreground="#4A7ACC" FontFamily="Segoe UI" Margin="0,1,0,0" TextWrapping="Wrap"/>
                                <TextBlock x:Name="InfoWereda" FontSize="10" Foreground="#5577AA" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                                <TextBlock x:Name="InfoKebele" FontSize="10" Foreground="#5577AA" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                                <TextBlock x:Name="InfoMobile" FontSize="10" Foreground="#5577AA" FontFamily="Segoe UI" Margin="0,1,0,0"/>
                            </StackPanel>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filter bar + Print -->
        <Grid Grid.Row="1" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Dept:" FontSize="11" FontWeight="SemiBold" Foreground="#4A6A9A" VerticalAlignment="Center" FontFamily="Segoe UI" Margin="0,0,5,0"/>
                <ComboBox x:Name="CmbFDept" Style="{StaticResource DD}" Width="100" SelectionChanged="CmbFDept_SelectionChanged"/>
                <TextBlock Text="Level:" FontSize="11" FontWeight="SemiBold" Foreground="#4A6A9A" VerticalAlignment="Center" FontFamily="Segoe UI" Margin="8,0,5,0"/>
                <ComboBox x:Name="CmbFLevel" Style="{StaticResource DD}" Width="60">
                    <ComboBoxItem Content="1" IsSelected="True"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/>
                    <ComboBoxItem Content="4"/>
                </ComboBox>
                <TextBlock Text="Adm Type:" FontSize="11" FontWeight="SemiBold" Foreground="#4A6A9A" VerticalAlignment="Center" FontFamily="Segoe UI" Margin="8,0,5,0"/>
                <ComboBox x:Name="CmbFAdmType" Style="{StaticResource DD}" Width="100">
                    <ComboBoxItem Content="Regular" IsSelected="True"/>
                    <ComboBoxItem Content="Extension"/>
                    <ComboBoxItem Content="Distance"/>
                </ComboBox>
                <Button Content="Filter" Click="BtnFilter_Click" Style="{StaticResource AB}" Margin="8,0,5,0" Height="28" Padding="12,0"><Button.Background><SolidColorBrush Color="#1A3A6A"/></Button.Background></Button>
                <Button Content="Reset"  Click="BtnResetFilter_Click" Style="{StaticResource AB}" Foreground="#5577AA" Height="28"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
            </StackPanel>

            <!-- Print + Export buttons -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button Click="BtnExportExcel_Click" Height="32" Width="100" Cursor="Hand" Margin="0,0,6,0">
                <Button.ToolTip>
                    <ToolTip Content="Export to Excel (CSV)" FontFamily="Segoe UI" FontSize="11"
                             Background="#0F1E36" Foreground="White" BorderBrush="#1E3A6A"/>
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" BorderThickness="1"
                                BorderBrush="#1A5A2A" Background="#0D2A14">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="8,0">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#4ADE80" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBlock Text="Export" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A4A2A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4ADE80"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Button Click="BtnPrint_Click" Height="32" Width="90" Cursor="Hand" VerticalAlignment="Center">
                <Button.ToolTip>
                    <ToolTip Content="Print Student List" FontFamily="Segoe UI" FontSize="11"
                             Background="#0F1E36" Foreground="White" BorderBrush="#1E3A6A"/>
                </Button.ToolTip>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" BorderThickness="1"
                                BorderBrush="#2A5A8A" Background="#0D2A4A">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                           Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Print" FontFamily="Segoe UI" FontSize="12"
                                           FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A4A7A"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A9AEE"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            </StackPanel>
        </Grid>

        <!-- Data grid -->
        <Grid Grid.Row="2">
            <Border x:Name="TableCard" CornerRadius="8" BorderThickness="1" ClipToBounds="True">
                <Border.BorderBrush><SolidColorBrush x:Name="TableCardBorder" Color="#1E3A6A"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
            <DataGrid x:Name="GridStudents" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      Background="Transparent" RowBackground="{DynamicResource TableRowBg}" AlternatingRowBackground="{DynamicResource TableRowBg}"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#0E1C30"
                      ColumnHeaderHeight="32" RowHeight="28" FontSize="11.5" FontFamily="Segoe UI" Foreground="{DynamicResource TableRowFg}" SelectionChanged="GridStudents_SelectionChanged">
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/>
                        <Setter Property="Foreground" Value="{DynamicResource TableHeaderFg}"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="8,0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#1A3A6B"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="Background" Value="{DynamicResource TableRowBg}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#1A3A6B"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0F2240"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}"
                                            BorderThickness="0" Padding="0">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="#"            Binding="{Binding _RowNo}"             Width="38" IsReadOnly="True"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Student ID"   Binding="{Binding student_id}"         Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Dept"         Binding="{Binding dept_id}"            Width="80"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Stream"       Binding="{Binding stream_id}"          Width="80"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Lvl"          Binding="{Binding level}"              Width="40"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="First Name"   Binding="{Binding first_name}"         Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Father Name"  Binding="{Binding father_name}"        Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="G/Father"     Binding="{Binding grand_father_name}"  Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Gender"       Binding="{Binding gender}"             Width="60"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Adm Date"     Binding="{Binding admission_date}"     Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Program"      Binding="{Binding program_type}"       Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Adm Type"     Binding="{Binding admission_type}"     Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Wereda"       Binding="{Binding wereda}"             Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Kebele"       Binding="{Binding kebele}"             Width="*"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="GPA 10"       Binding="{Binding gpa_grade_10th}"     Width="60"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="GPA 12"       Binding="{Binding gpa_grade_12th}"     Width="60"/>
                    <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Mobile"       Binding="{Binding mobile_number1}"     Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <!-- Loading overlay — spans all rows, blocks all input -->
        <Border x:Name="RegLoadingOverlay" Grid.Row="0" Grid.RowSpan="3"
                Visibility="Collapsed" Panel.ZIndex="99" IsHitTestVisible="True">
            <Border.Background><SolidColorBrush Color="#CC000000"/></Border.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="56" Height="56"/>
                <TextBlock x:Name="TxtOverlayMsg" Text="Loading..." Foreground="White" FontSize="15"
                           FontWeight="SemiBold" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,16,0,0"/>
            </StackPanel>
        </Border>
        </Grid>
    </Grid>
</Page>
