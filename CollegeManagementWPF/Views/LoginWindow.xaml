<ui:FluentWindow
    x:Class="CollegeManagementWPF.Views.LoginWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="College Management Login"
    Width="980" Height="640" MinWidth="780" MinHeight="520"
    WindowStartupLocation="CenterScreen" WindowState="Maximized"
    Icon="/Assets/app.ico" ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica" Background="#161622">
    <ui:FluentWindow.Resources>
        <Style x:Key="GradientButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#7C3AED" Offset="0"/><GradientStop Color="#A855F7" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#6D28D9" Offset="0"/><GradientStop Color="#9333EA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IpBox" TargetType="ui:TextBox">
            <Setter Property="Width" Value="58"/><Setter Property="MaxLength" Value="3"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="12"/>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Wukro St. Mary College - Management System" Foreground="White">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Assets/app.ico"/></ui:TitleBar.Icon>
            <ui:TitleBar.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A1F8C" Offset="0"/><GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </ui:TitleBar.Background>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="300" MaxWidth="460"/>
                <ColumnDefinition Width="3*" MinWidth="400"/>
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0" ClipToBounds="True">
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#0D1B3E" Offset="0"/>
                            <GradientStop Color="#0A1628" Offset="0.5"/>
                            <GradientStop Color="#071020" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Ellipse Width="300" Height="300" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-60,-60,0" Opacity="0.18">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#2255DD" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="280" Height="280" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-60,0,0,-60" Opacity="0.15">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1166AA" Offset="0"/><GradientStop Color="Transparent" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                </Ellipse>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30,0">
                    <Image Source="/Assets/st_mary_logo.png" Width="110" Height="110" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,0,24"/>
                    <TextBlock Text="Welcome to Ethiopian Catholic Diocese of Adigrat"
                               FontSize="16" FontWeight="Bold" Foreground="White"
                               TextAlignment="Center" FontFamily="Segoe UI"
                               TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <TextBlock Text="Wukro St.Mary's College"
                               FontSize="18" FontWeight="Bold" Foreground="White"
                               TextAlignment="Center" FontFamily="Segoe UI"
                               Margin="0,0,0,10"/>
                    <TextBlock Text="College Management System"
                               FontSize="13" FontStyle="Italic" FontWeight="SemiBold"
                               Foreground="#A0AEC0"
                               TextAlignment="Center" FontFamily="Segoe UI"/>
                </StackPanel>
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="16,0,0,16" CornerRadius="20" Padding="12,6" BorderThickness="1" BorderBrush="#3A3A6A">
                    <Border.Background><SolidColorBrush Color="#1A1A3A"/></Border.Background>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔒 " FontSize="12" Foreground="#6C63FF" VerticalAlignment="Center"/>
                        <TextBlock Text="Secure Login" FontSize="11" Foreground="#A0AEC0" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Border>
            </Grid>
            <Border Grid.Column="1">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0D1B3E" Offset="0"/><GradientStop Color="#0A1428" Offset="0.5"/><GradientStop Color="#071020" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Margin="40,60,40,40">
                            <TextBlock Text="Sign in" FontSize="28" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <TextBlock Text="Enter your credentials to access your account" FontSize="12" Foreground="#8888AA" FontFamily="Segoe UI" Margin="0,0,0,28"/>
                            <TextBlock Text="Username" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCDD" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <ui:TextBox x:Name="TxtUsername" PlaceholderText="Enter your username" FontSize="13" Height="46" Margin="0,0,0,18" KeyDown="Input_KeyDown">
                                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Person24"/></ui:TextBox.Icon>
                            </ui:TextBox>
                            <TextBlock Text="Password" FontSize="11" FontWeight="SemiBold" Foreground="#CCCCDD" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                            <ui:PasswordBox x:Name="TxtPassword" PlaceholderText="Enter your password" FontSize="13" Height="46" Margin="0,0,0,8" KeyDown="Input_KeyDown">
                                <ui:PasswordBox.Icon><ui:SymbolIcon Symbol="LockClosed24"/></ui:PasswordBox.Icon>
                            </ui:PasswordBox>
                            <Expander Header="Database Host  (optional)" Foreground="#8888AA" FontFamily="Segoe UI" FontSize="11" Margin="0,8,0,20" IsExpanded="False">
                                <Border Margin="0,10,0,4" CornerRadius="8" Padding="14,12" BorderThickness="1" BorderBrush="#2A2A4A">
                                    <Border.Background><SolidColorBrush Color="#0D0D22"/></Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="Enter DB Server IP Address" FontSize="10" Foreground="#5577AA" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                            <TextBox x:Name="IP_a" Width="60" MaxLength="3" TextAlignment="Center" FontSize="13"
                                                     Background="#1A1A3A" Foreground="White" BorderBrush="#3A3A6A" BorderThickness="1"
                                                     Padding="4,6" FontFamily="Segoe UI" CaretBrush="White" Text=""/>
                                            <TextBlock Text="." FontSize="20" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBox x:Name="IP_b" Width="60" MaxLength="3" TextAlignment="Center" FontSize="13"
                                                     Background="#1A1A3A" Foreground="White" BorderBrush="#3A3A6A" BorderThickness="1"
                                                     Padding="4,6" FontFamily="Segoe UI" CaretBrush="White" Text=""/>
                                            <TextBlock Text="." FontSize="20" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBox x:Name="IP_c" Width="60" MaxLength="3" TextAlignment="Center" FontSize="13"
                                                     Background="#1A1A3A" Foreground="White" BorderBrush="#3A3A6A" BorderThickness="1"
                                                     Padding="4,6" FontFamily="Segoe UI" CaretBrush="White" Text=""/>
                                            <TextBlock Text="." FontSize="20" FontWeight="Bold" Foreground="#7C3AED" VerticalAlignment="Center" Margin="4,0"/>
                                            <TextBox x:Name="IP_d" Width="60" MaxLength="3" TextAlignment="Center" FontSize="13"
                                                     Background="#1A1A3A" Foreground="White" BorderBrush="#3A3A6A" BorderThickness="1"
                                                     Padding="4,6" FontFamily="Segoe UI" CaretBrush="White" Text=""/>
                                        </StackPanel>
                                        <TextBlock Text="Leave blank to use 127.0.0.1 (localhost)" FontSize="10" Foreground="#444466" FontStyle="Italic" FontFamily="Segoe UI" Margin="0,8,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Expander>
                            <Border x:Name="ErrorBorder" Background="#2D1020" CornerRadius="6" Padding="12,8" Margin="0,0,0,14" Visibility="Collapsed">
                                <TextBlock x:Name="TxtError" FontSize="12" Foreground="#FF5070" FontFamily="Segoe UI"/>
                            </Border>
                            <Button Content="Sign in" Style="{StaticResource GradientButton}" Height="48" HorizontalAlignment="Stretch" Click="BtnLogin_Click"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="© 2024 Wukro St. Mary College Management System" HorizontalAlignment="Center" Margin="0,0,0,14" FontSize="10" Foreground="#404055" FontFamily="Segoe UI"/>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
