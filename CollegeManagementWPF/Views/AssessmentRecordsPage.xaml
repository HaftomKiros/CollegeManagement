<Page x:Class="CollegeManagementWPF.Views.AssessmentRecordsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>
    <Page.Resources>
        <Style x:Key="FL" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource RegLabelFg}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="WI" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DD" TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid><ToggleButton BorderThickness="0" Background="Transparent" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderThickness="0"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,24,0" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#4A7ACC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/></Grid></Border><Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" Placement="Bottom" PopupAnimation="Slide"><Border Background="{DynamicResource RegInputBg}" BorderBrush="{DynamicResource RegInputBorder}" BorderThickness="1" CornerRadius="0,0,6,6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200"><ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter><Style.Resources><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Style.Resources></Style>
        <Style x:Key="TC" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
        <Style x:Key="AB" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>

        <!-- Searchable editable dropdown — PART_EditableTextBox shows selected value -->
        <Style x:Key="SDD" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource RegInputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="IsEditable" Value="True"/>
            <Setter Property="IsTextSearchEnabled" Value="True"/>
            <Setter Property="StaysOpenOnEdit" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                                <Grid>
                                    <TextBox x:Name="PART_EditableTextBox"
                                             Background="Transparent" BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontSize="{TemplateBinding FontSize}"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             Margin="8,0,28,0" VerticalAlignment="Center"
                                             IsReadOnly="{TemplateBinding IsReadOnly}"/>
                                    <ToggleButton BorderThickness="0" Background="Transparent"
                                                  IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}"
                                                  Focusable="False" ClickMode="Press"
                                                  HorizontalAlignment="Right" Width="28" VerticalAlignment="Stretch">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" BorderThickness="0">
                                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9"
                                                               Foreground="#4A7ACC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True"
                                   Focusable="False" Placement="Bottom" PopupAnimation="Slide">
                                <Border Background="{DynamicResource RegInputBg}"
                                        BorderBrush="{DynamicResource RegInputBorder}"
                                        BorderThickness="1" CornerRadius="0,0,6,6"
                                        MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#4A7ACC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Resources>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="{DynamicResource RegInputBg}"/>
                    <Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger>
                        <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger>
                    </Style.Triggers>
                </Style>
            </Style.Resources>
        </Style>
    </Page.Resources>

    <Grid Margin="16,10,16,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="220"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: Entry + Table -->
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Entry card -->
            <Border Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,10" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Row 1: Student ID, Level, Module, Instructor -->
                    <UniformGrid Grid.Row="0" Rows="1" Columns="4">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Student ID" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbStudID" Style="{StaticResource SDD}"
                                      IsTextSearchEnabled="False"
                                      TextBoxBase.TextChanged="CmbStudID_TextChanged"
                                      SelectionChanged="CmbStudID_SelectionChanged"
                                      LostFocus="CmbStudID_LostFocus"/>
                            <TextBlock x:Name="TxtStudentName" FontSize="10" FontStyle="Italic" Foreground="#4A9AEE"
                                       FontFamily="Segoe UI" Margin="2,3,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Level" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbLevel" Style="{StaticResource DD}"
                                      SelectionChanged="CmbLevel_SelectionChanged">
                                <ComboBoxItem Content="1" IsSelected="True"/>
                                <ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Module Code" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbModCode" Style="{StaticResource DD}"
                                      SelectionChanged="CmbModCode_SelectionChanged"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Instructor ID" Style="{StaticResource FL}"/>
                            <ComboBox x:Name="CmbEmpID" Style="{StaticResource SDD}"
                                      IsEditable="True" StaysOpenOnEdit="True"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Row 2: Academic Year, Institutional(70%), Industry(30%), Grade -->
                    <UniformGrid Grid.Row="2" Rows="1" Columns="4">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Academic Year" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtAcadYear" Style="{StaticResource WI}"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Institutional Assessment (70%)" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtInstitutional" Style="{StaticResource WI}" TextChanged="ScoreChanged"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Industry Assessment (30%)" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtIndustry" Style="{StaticResource WI}" TextChanged="ScoreChanged"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Total Score" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtTotal" Style="{StaticResource WI}" IsReadOnly="True"/>
                            <TextBlock x:Name="TxtScoreError" Text="Total score exceeds 100!" FontSize="10"
                                       Foreground="#F87171" FontFamily="Segoe UI" Margin="2,3,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>
                    </UniformGrid>

                    <!-- Row 3: Grade (letter) -->
                    <UniformGrid Grid.Row="4" Rows="1" Columns="4">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Grade" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtGrade" Style="{StaticResource WI}" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Grade Points" Style="{StaticResource FL}"/>
                            <TextBox x:Name="TxtGradePoints" Style="{StaticResource WI}" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel/>
                        <StackPanel/>
                    </UniformGrid>
                </Grid>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button x:Name="BtnSave" Content="Save"   Click="BtnSave_Click"   Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                <Button x:Name="BtnUpdate" Content="Update" Click="BtnUpdate_Click" Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#1A9944"/></Button.Background></Button>
                <Button Content="Delete" Click="BtnDelete_Click" Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#CC2222"/></Button.Background></Button>
                <Button Content="Clear"  Click="BtnClear_Click"  Style="{StaticResource AB}" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
            </StackPanel>

            <!-- Quick filter -->
            <Border Grid.Row="2" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Quick Filter:" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RegLabelFg}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="TxtFilter" Style="{StaticResource WI}" Width="200" Height="30" TextChanged="TxtFilter_Changed"/>
                    <Button Content="Reset" Click="BtnReset_Click" Style="{StaticResource AB}" Height="30" Padding="12,0" Margin="6,0,0,0" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
                </StackPanel>
            </Border>

            <!-- Table -->
            <Grid Grid.Row="3">
                <Border CornerRadius="10" BorderThickness="1" ClipToBounds="True">
                    <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                    <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                    <DataGrid x:Name="Grid1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                              Background="Transparent" RowBackground="{DynamicResource TableRowBg}"
                              BorderThickness="0" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{DynamicResource RegInputBorder}"
                              ColumnHeaderHeight="34" RowHeight="30" FontSize="11.5" FontFamily="Segoe UI"
                              Foreground="{DynamicResource TableRowFg}"
                              SelectionChanged="Grid1_SelectionChanged">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TableHeaderFg}"/>
                                <Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="8,0"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/>
                                <Setter Property="Background" Value="{DynamicResource TableRowBg}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TableRowHoverBg}"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Student ID"        Binding="{Binding student_id}"         Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Lvl"              Binding="{Binding level}"              Width="40"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Module"           Binding="{Binding module_code}"        Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Instructor"       Binding="{Binding employee_id}"        Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Year"             Binding="{Binding academic_year}"      Width="60"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Institutional(70%)" Binding="{Binding institutional_score}" Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Industry(30%)"    Binding="{Binding industry_score}"     Width="*"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Total"            Binding="{Binding total_score}"        Width="60"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Grade"            Binding="{Binding letter_grade}"       Width="60"/>
                            <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Points"           Binding="{Binding grade_points}"       Width="60"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
                <Border x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="10">
                    <Border.Background><SolidColorBrush Color="#80000000"/></Border.Background>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:ProgressRing IsIndeterminate="True" Width="40" Height="40"/>
                        <TextBlock Text="Loading..." Foreground="White" FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- RIGHT: Filter -->
        <Border Grid.Column="1" CornerRadius="12" Padding="14,16" BorderThickness="1" VerticalAlignment="Top">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="Filter By" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI"/>
                </StackPanel>
                <Border Height="1" Margin="0,0,0,12"><Border.Background><DynamicResource ResourceKey="RegInputBorder"/></Border.Background></Border>

                <TextBlock Text="Student ID" Style="{StaticResource FL}"/>
                <TextBox x:Name="TxtFStudID" Style="{StaticResource WI}" Margin="0,0,0,8"/>

                <TextBlock Text="Year" Style="{StaticResource FL}"/>
                <TextBox x:Name="TxtFYear" Style="{StaticResource WI}" Margin="0,0,0,8"/>

                <TextBlock Text="Level" Style="{StaticResource FL}"/>
                <ComboBox x:Name="CmbFLevel" Style="{StaticResource DD}" Margin="0,0,0,8">
                    <ComboBoxItem Content="(All)" IsSelected="True"/>
                    <ComboBoxItem Content="1"/><ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="3"/><ComboBoxItem Content="4"/>
                </ComboBox>

                <Border Height="1" Margin="0,4,0,12"><Border.Background><DynamicResource ResourceKey="RegInputBorder"/></Border.Background></Border>
                <Button Content="Filter" Click="BtnFilter_Click" Height="32" Padding="14,0" Margin="0,0,0,6" Foreground="White" Style="{StaticResource AB}"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                <Button Content="Reset"  Click="BtnFilterReset_Click" Height="32" Padding="14,0" Foreground="#5577AA" Style="{StaticResource AB}"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
