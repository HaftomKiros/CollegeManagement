<ui:FluentWindow
    x:Class="CollegeManagementWPF.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="College Management System"
    Width="1200" Height="720" MinWidth="900" MinHeight="560"
    WindowStartupLocation="CenterScreen" WindowState="Maximized"
    Icon="/Assets/app.ico" ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica" Background="#0D1B3E">
    <ui:FluentWindow.Resources>
        <Style x:Key="SubBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#6B8CAE"/>
            <Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="BorderThickness" Value="0"/><Setter Property="Height" Value="36"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,0,12,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="10,1,10,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#112240"/><Setter Property="Foreground" Value="#E2EAF4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SectionBtn" TargetType="Button">
            <Setter Property="Background" Value="#0D1F3C"/><Setter Property="Foreground" Value="#C8DCF0"/>
            <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="12,0"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="8,3,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#14305A"/><Setter Property="Foreground" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="Wukro St. Mary College - Management System" Foreground="White">
            <ui:TitleBar.Icon><ui:ImageIcon Source="/Assets/app.ico"/></ui:TitleBar.Icon>
            <ui:TitleBar.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A1F8C" Offset="0"/><GradientStop Color="#0F3460" Offset="1"/>
                </LinearGradientBrush>
            </ui:TitleBar.Background>
        </ui:TitleBar>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="258"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#0A1628" Offset="0"/><GradientStop Color="#070E1C" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="16,18,16,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0D1F3C" Offset="0"/><GradientStop Color="#0A1628" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Image Source="/Assets/st_mary_logo.png" Width="40" Height="40" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="St. Mary College" FontSize="13" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                                    <TextBlock Text="Management System" FontSize="10" Foreground="#2A4A7A" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </StackPanel>
                            <Rectangle Height="1">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="#1A3A6B" Offset="0.5"/><GradientStop Color="Transparent" Offset="1"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </StackPanel>
                    </Border>
                    <Border DockPanel.Dock="Bottom" Padding="8,8,8,12">
                        <Button Click="BtnSignOut_Click" Style="{StaticResource SectionBtn}" Background="#1A0A0A" Margin="8,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="6" Background="#3D1010" Margin="0,0,10,0">
                                    <ui:SymbolIcon Symbol="DoorArrowRight20" FontSize="14" Foreground="#FF6B6B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Sign Out" FontSize="12.5" Foreground="#FF6B6B" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,6,0,6">
                            <Border Margin="8,0,8,3" CornerRadius="10" Height="48" Cursor="Hand">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#1A3A6B" Offset="0"/><GradientStop Color="#0F2A55" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Button Tag="Dashboard" Click="NavButton_Click" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Left" Padding="10,0" Height="48" Cursor="Hand">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="8" Background="#1A4A8A" Margin="0,0,12,0">
                                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Foreground="#5BA3FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="Dashboard" FontSize="13" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Button>
                            </Border>
                            <Button x:Name="BtnStudents" Tag="Students" Style="{StaticResource SectionBtn}" Click="Section_Click">
                                <Grid Width="220">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#0D2A1A" Margin="0,0,10,0">
                                        <ui:SymbolIcon Symbol="PersonAdd24" FontSize="15" Foreground="#2ECC71" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="Students" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChevStudents" Grid.Column="2" Text="⌄" FontSize="14" Foreground="#2A4A7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="PanStudents" Visibility="Collapsed" Margin="0,2,0,4">
                                <Button Tag="StudentRegistration" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PersonAdd24" FontSize="13" Foreground="#2ECC71" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Student Registration" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="StudentMarks" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ClipboardTaskListLtr20" FontSize="13" Foreground="#818CF8" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Student Marks" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="StudentFees" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Money24" FontSize="13" Foreground="#34D399" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Student Fees" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="DropoutStudents" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PersonDelete24" FontSize="13" Foreground="#F87171" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Dropout Students" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="COCRecord" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentPdf24" FontSize="13" Foreground="#C084FC" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="COC Record" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                            <Button x:Name="BtnDepts" Tag="Departments" Style="{StaticResource SectionBtn}" Click="Section_Click">
                                <Grid Width="220">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#0D2A2A" Margin="0,0,10,0"><ui:SymbolIcon Symbol="Building24" FontSize="15" Foreground="#67E8F9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Grid.Column="1" Text="Departments" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChevDepts" Grid.Column="2" Text="⌄" FontSize="14" Foreground="#2A4A7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="PanDepts" Visibility="Collapsed" Margin="0,2,0,4">
                                <Button Tag="Departments" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Building24" FontSize="13" Foreground="#67E8F9" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Departments" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="Streams" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="BranchFork24" FontSize="13" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Streams" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="Levels" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="LayerDiagonal24" FontSize="13" Foreground="#60A5FA" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Levels" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="Courses" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="BookOpen24" FontSize="13" Foreground="#A78BFA" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Courses" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                            <Button x:Name="BtnEmp" Tag="Employees" Style="{StaticResource SectionBtn}" Click="Section_Click">
                                <Grid Width="220"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#1A1A2A" Margin="0,0,10,0"><ui:SymbolIcon Symbol="PeopleTeam24" FontSize="15" Foreground="#818CF8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Grid.Column="1" Text="Employees" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChevEmp" Grid.Column="2" Text="⌄" FontSize="14" Foreground="#2A4A7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="PanEmp" Visibility="Collapsed" Margin="0,2,0,4">
                                <Button Tag="RegisterEmployee" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PersonAdd24" FontSize="13" Foreground="#818CF8" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Register Employee" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                            <Button x:Name="BtnAlumni" Tag="Alumni" Style="{StaticResource SectionBtn}" Click="Section_Click">
                                <Grid Width="220"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#0D1E2A" Margin="0,0,10,0"><ui:SymbolIcon Symbol="PeopleCommunity24" FontSize="15" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Grid.Column="1" Text="Alumni" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChevAlumni" Grid.Column="2" Text="⌄" FontSize="14" Foreground="#2A4A7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="PanAlumni" Visibility="Collapsed" Margin="0,2,0,4">
                                <Button Tag="RegisterAlumni" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PeopleCommunity24" FontSize="13" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Register Alumni" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                            <Button x:Name="BtnLib" Tag="Library" Style="{StaticResource SectionBtn}" Click="Section_Click">
                                <Grid Width="220"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#0D2A1A" Margin="0,0,10,0"><ui:SymbolIcon Symbol="Library24" FontSize="15" Foreground="#4ADE80" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Grid.Column="1" Text="Library" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChevLib" Grid.Column="2" Text="⌄" FontSize="14" Foreground="#2A4A7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="PanLib" Visibility="Collapsed" Margin="0,2,0,4">
                                <Button Tag="Library" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Library24" FontSize="13" Foreground="#4ADE80" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Library" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                            <Button x:Name="BtnReports" Tag="Reports" Style="{StaticResource SectionBtn}" Click="Section_Click">
                                <Grid Width="220"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#1A1020" Margin="0,0,10,0"><ui:SymbolIcon Symbol="DocumentPdf24" FontSize="15" Foreground="#C084FC" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Grid.Column="1" Text="Reports" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChevReports" Grid.Column="2" Text="⌄" FontSize="14" Foreground="#2A4A7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="PanReports" Visibility="Collapsed" Margin="0,2,0,4">
                                <Button Tag="TVETTranscript" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentPdf24" FontSize="13" Foreground="#C084FC" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="TVET Transcript" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="MarkList" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ClipboardTaskListLtr20" FontSize="13" Foreground="#818CF8" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Mark List" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="AttendanceSheet" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="CalendarLtr24" FontSize="13" Foreground="#FCD34D" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Attendance Sheet" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="COCList" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ClipboardTaskListLtr20" FontSize="13" Foreground="#A78BFA" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="COC List" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                            <Button x:Name="BtnAdmins" Tag="Admins" Style="{StaticResource SectionBtn}" Click="Section_Click">
                                <Grid Width="220"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="8" Background="#2A0A2A" Margin="0,0,10,0"><ui:SymbolIcon Symbol="ShieldPerson20" FontSize="15" Foreground="#E879F9" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <TextBlock Grid.Column="1" Text="Admins" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ChevAdmins" Grid.Column="2" Text="⌄" FontSize="14" Foreground="#2A4A7A" VerticalAlignment="Center" Margin="0,0,4,0"/>
                                </Grid>
                            </Button>
                            <StackPanel x:Name="PanAdmins" Visibility="Collapsed" Margin="0,2,0,4">
                                <Button Tag="ManageAdmins" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ShieldPerson20" FontSize="13" Foreground="#E879F9" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Manage Admins" VerticalAlignment="Center"/></StackPanel></Button>
                                <Button Tag="Migration" Style="{StaticResource SubBtn}" Click="NavButton_Click"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Foreground="#FCD34D" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="BLOB Migration" VerticalAlignment="Center"/></StackPanel></Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="58"/><RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderThickness="0,0,0,1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#0D1B3E" Offset="0"/><GradientStop Color="#0A1628" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="Transparent" Offset="0"/><GradientStop Color="#1A3A6B" Offset="0.5"/><GradientStop Color="Transparent" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Grid Margin="24,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPageTitle" Text="Dashboard" FontSize="16" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI"/>
                            <TextBlock x:Name="TxtPageSubTitle" Text="" FontSize="11" Foreground="#2A4A7A" FontFamily="Segoe UI" Visibility="Collapsed"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <StackPanel x:Name="SearchPanel" Orientation="Horizontal" Margin="0,0,14,0" Visibility="Collapsed">
                                <Border CornerRadius="5" Height="30" Width="220" BorderThickness="1" BorderBrush="#1E3A6A" Margin="0,0,5,0">
                                    <Border.Background><SolidColorBrush Color="#060C18"/></Border.Background>
                                    <Grid Margin="8,0">
                                        <TextBlock x:Name="TopSearchHint" Text="Search by ID or name..." Foreground="#2A4A7A" FontSize="11" VerticalAlignment="Center" FontFamily="Segoe UI" IsHitTestVisible="False"/>
                                        <TextBox x:Name="TopSearchBox" Background="Transparent" BorderThickness="0" Foreground="White" FontSize="11" VerticalContentAlignment="Center" FontFamily="Segoe UI" TextChanged="TopSearch_TextChanged"/>
                                    </Grid>
                                </Border>
                                <Button Content="Search" Click="TopSearch_Click" Height="30" FontSize="11" FontFamily="Segoe UI" Foreground="White" BorderThickness="0" Cursor="Hand" Padding="12,0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="5" Background="#1A3A6B" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                            <Border CornerRadius="20" Padding="12,5" BorderThickness="1" BorderBrush="#1A3A6B">
                                <Border.Background><SolidColorBrush Color="#0D1B3E"/></Border.Background>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="22" Height="22" Margin="0,0,8,0">
                                        <Ellipse.Fill>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#2244CC" Offset="0"/><GradientStop Color="#1166AA" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <TextBlock Text="Administrator" FontSize="12" Foreground="#88AACC" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Frame x:Name="ContentFrame" Grid.Row="1" NavigationUIVisibility="Hidden" Background="Transparent"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
