<Page x:Class="CollegeManagementWPF.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:CollegeManagementWPF.Views">
    <Page.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/><GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/></LinearGradientBrush></Page.Background>
    <Page.Resources>
        <local:AddOneConverter x:Key="AddOneConverter"/>
        <Style x:Key="FL" TargetType="TextBlock"><Setter Property="FontSize" Value="10.5"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource RegLabelFg}"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Margin" Value="0,0,0,3"/></Style>
        <Style x:Key="WI" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontSize" Value="12"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Height" Value="32"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
        <Style x:Key="DD" TargetType="ComboBox"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="FontSize" Value="12"/><Setter Property="Height" Value="32"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="OverridesDefaultStyle" Value="True"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6"><Grid><ToggleButton BorderThickness="0" Background="Transparent" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent" BorderThickness="0"/></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="8,0,24,0" VerticalAlignment="Center"/><TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="9" Foreground="#4A7ACC" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" IsHitTestVisible="False"/></Grid></Border><Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" Placement="Bottom" PopupAnimation="Slide"><Border Background="{DynamicResource RegInputBg}" BorderBrush="{DynamicResource RegInputBorder}" BorderThickness="1" CornerRadius="0,0,6,6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="200"><ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter><Style.Resources><Style TargetType="ComboBoxItem"><Setter Property="Background" Value="{DynamicResource RegInputBg}"/><Setter Property="Foreground" Value="{DynamicResource RegInputFg}"/><Setter Property="Padding" Value="8,6"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></Style.Resources></Style>
        <Style x:Key="TC" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Margin" Value="8,0"/></Style>
        <Style x:Key="AB" TargetType="Button"><Setter Property="Height" Value="34"/><Setter Property="FontSize" Value="12.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="18,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="8" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Page.Resources>
    <Grid Margin="16,10,16,10">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="215"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Grid.Row="0" CornerRadius="12" Padding="16,14" Margin="0,0,0,10" BorderThickness="1"><Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush><Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <UniformGrid Grid.Row="0" Rows="1" Columns="4">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Book ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtBookID" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Book Type" Style="{StaticResource FL}"/><ComboBox x:Name="CmbBookType" Style="{StaticResource DD}"><ComboBoxItem Content="Ref. Book" IsSelected="True"/><ComboBoxItem Content="Instructor Handout"/></ComboBox></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Book Title" Style="{StaticResource FL}"/><TextBox x:Name="TxtTitle" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel><TextBlock Text="Dept ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtDeptID" Style="{StaticResource WI}"/></StackPanel>
                    </UniformGrid>
                    <UniformGrid Grid.Row="2" Rows="1" Columns="4">
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Stream ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtStreamID" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Level ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtLevelID" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,8,0"><TextBlock Text="Module Code" Style="{StaticResource FL}"/><TextBox x:Name="TxtModCode" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel><TextBlock Text="Book File" Style="{StaticResource FL}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtFilePath" Grid.Column="0" Style="{StaticResource WI}" IsReadOnly="True" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Click="BtnBrowse_Click" Width="32" Height="32" Cursor="Hand" BorderThickness="0" ToolTip="Browse" Margin="0,0,4,0"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="6" Background="{DynamicResource RegBrowseBg}"><TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                            <Button Grid.Column="2" Click="BtnDownload_Click" Width="32" Height="32" Cursor="Hand" BorderThickness="0" ToolTip="Download"><Button.Template><ControlTemplate TargetType="Button"><Border x:Name="bd" CornerRadius="6" Background="#1A5A3A"><TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.8"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template></Button>
                        </Grid></StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Content="Save"   Click="BtnSave_Click"   Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                <Button Content="Update" Click="BtnUpdate_Click" Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#1A9944"/></Button.Background></Button>
                <Button Content="Delete" Click="BtnDelete_Click" Style="{StaticResource AB}" Margin="0,0,6,0"><Button.Background><SolidColorBrush Color="#CC2222"/></Button.Background></Button>
                <Button Content="Clear"  Click="BtnClear_Click"  Style="{StaticResource AB}" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
            </StackPanel>
            <Grid Grid.Row="3"><Border CornerRadius="10" BorderThickness="1" ClipToBounds="True"><Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush><Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                <DataGrid x:Name="Grid1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" Background="Transparent" RowBackground="{DynamicResource TableRowBg}" AlternatingRowBackground="{DynamicResource TableRowBg}" BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource RegInputBorder}" ColumnHeaderHeight="34" RowHeight="30" FontSize="11.5" FontFamily="Segoe UI" Foreground="{DynamicResource TableRowFg}" SelectionChanged="Grid1_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader"><Setter Property="Background" Value="{DynamicResource TableHeaderBg}"/><Setter Property="Foreground" Value="{DynamicResource TableHeaderFg}"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Padding" Value="8,0"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="BorderBrush" Value="{DynamicResource RegInputBorder}"/></Style></DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle><Style TargetType="DataGridRow"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="Background" Value="{DynamicResource TableRowBg}"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#1A3A6B"/><Setter Property="Foreground" Value="White"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource TableRowHoverBg}"/></Trigger></Style.Triggers></Style></DataGrid.RowStyle>
                    <DataGrid.CellStyle><Style TargetType="DataGridCell"><Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="DataGridCell"><Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0"><ContentPresenter VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/></Trigger></Style.Triggers></Style></DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="#"          Binding="{Binding _RowNo}"           Width="38"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Book ID"    Binding="{Binding book_id}"          Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Type"       Binding="{Binding book_type}"        Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Title"      Binding="{Binding book_title}"       Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Dept"       Binding="{Binding book_dept_id}"     Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Stream"     Binding="{Binding book_stream_id}"   Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Level"      Binding="{Binding book_level_id}"    Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Module"     Binding="{Binding book_module_code}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid></Border>
                <Border x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="10"><Border.Background><SolidColorBrush Color="#A0000000"/></Border.Background><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ui:ProgressRing IsIndeterminate="True" Width="44" Height="44"/><TextBlock Text="Loading..." Foreground="White" FontSize="13" FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,10,0,0"/></StackPanel></Border>
            </Grid>
        </Grid>
        <Border Grid.Column="1" CornerRadius="12" Padding="14,16" BorderThickness="1" VerticalAlignment="Top"><Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush><Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="Search By" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI"/></StackPanel>
                <Border Height="1" Margin="0,0,0,10"><Border.Background><DynamicResource ResourceKey="RegInputBorder"/></Border.Background></Border>
                <TextBlock Text="Book ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtFBookID" Style="{StaticResource WI}" Margin="0,0,0,8"/>
                <TextBlock Text="OR..." FontSize="12" FontWeight="Bold" Foreground="#22AA66" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                <TextBlock Text="Book Title" Style="{StaticResource FL}"/><TextBox x:Name="TxtFTitle" Style="{StaticResource WI}" Margin="0,0,0,8"/>
                <TextBlock Text="OR..." FontSize="12" FontWeight="Bold" Foreground="#22AA66" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                <TextBlock Text="Dept ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtFDept" Style="{StaticResource WI}" Margin="0,0,0,8"/>
                <TextBlock Text="Stream ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtFStream" Style="{StaticResource WI}" Margin="0,0,0,16"/>
                <Border Height="1" Margin="0,0,0,12"><Border.Background><DynamicResource ResourceKey="RegInputBorder"/></Border.Background></Border>
                <StackPanel Orientation="Horizontal">
                    <Button Content="Filter" Click="BtnFilter_Click" Style="{StaticResource AB}" Height="32" Padding="14,0" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                    <Button Content="Reset" Click="BtnFilterReset_Click" Style="{StaticResource AB}" Height="32" Padding="12,0" Foreground="#5577AA"><Button.Background><SolidColorBrush Color="Transparent"/></Button.Background></Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
