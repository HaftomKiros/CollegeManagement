<Page x:Class="CollegeManagementWPF.Views.AssignPathPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" CornerRadius="14" Padding="24,18" BorderThickness="1"
                BorderBrush="#0D9488">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A2A2A" Offset="0"/>
                    <GradientStop Color="#051515" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Border Width="50" Height="50" CornerRadius="12" Background="#0D3A3A" Margin="0,0,16,0">
                    <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="#2DD4BF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Assign Storage Paths" FontSize="20" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Set individual folders for photos, attachments and mark list documents."
                               FontSize="11.5" Foreground="#5EAAA8" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Configuration card -->
        <Border Grid.Row="2" CornerRadius="12" Padding="22,18" BorderThickness="1">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel>

                <TextBlock Text="Storage Path Configuration" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" Margin="0,0,0,8"/>

                <!-- DB status -->
                <Border x:Name="DbStatusBorder" CornerRadius="6" Padding="10,6" Margin="0,0,0,18"
                        BorderThickness="1" BorderBrush="#1A3A2A" Background="#0A1F14">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="DbStatusIcon" Text="⏳" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="DbStatusText" Text="Checking database..."
                                   FontSize="11" FontFamily="Segoe UI" Foreground="#5EAAA8" VerticalAlignment="Center"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Photos path -->
                <TextBlock Text="&#xE719;  Photos Folder" FontSize="11" FontWeight="SemiBold"
                           Foreground="#F59E0B" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Padding="12,0" Height="36" BorderThickness="1">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Border.Background><DynamicResource ResourceKey="RegInputBg"/></Border.Background>
                        <TextBlock x:Name="TxtPhotosPath" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{DynamicResource RegInputFg}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="2" Click="BtnBrowsePhotos_Click" Height="36" Padding="14,0" Cursor="Hand"
                            Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Background="#0D6B6B" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Browse" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Attachments path -->
                <TextBlock Text="&#xE8A5;  Attachments Folder" FontSize="11" FontWeight="SemiBold"
                           Foreground="#60A5FA" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Padding="12,0" Height="36" BorderThickness="1">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Border.Background><DynamicResource ResourceKey="RegInputBg"/></Border.Background>
                        <TextBlock x:Name="TxtAttachPath" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{DynamicResource RegInputFg}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="2" Click="BtnBrowseAttach_Click" Height="36" Padding="14,0" Cursor="Hand"
                            Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Background="#0D6B6B" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Browse" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Mark lists path -->
                <TextBlock Text="&#xE8F9;  Mark List Documents Folder" FontSize="11" FontWeight="SemiBold"
                           Foreground="#A78BFA" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Padding="12,0" Height="36" BorderThickness="1">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Border.Background><DynamicResource ResourceKey="RegInputBg"/></Border.Background>
                        <TextBlock x:Name="TxtMlPath" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{DynamicResource RegInputFg}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="2" Click="BtnBrowseMl_Click" Height="36" Padding="14,0" Cursor="Hand"
                            Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Background="#0D6B6B" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Browse" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Assessments path -->
                <TextBlock Text="&#xE9D5;  Assessment Documents Folder" FontSize="11" FontWeight="SemiBold"
                           Foreground="#34D399" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Padding="12,0" Height="36" BorderThickness="1">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Border.Background><DynamicResource ResourceKey="RegInputBg"/></Border.Background>
                        <TextBlock x:Name="TxtAssessPath" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{DynamicResource RegInputFg}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="2" Click="BtnBrowseAssess_Click" Height="36" Padding="14,0" Cursor="Hand"
                            Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Background="#0D6B6B" Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="Browse" FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Save button -->
                <Button Click="BtnSave_Click" HorizontalAlignment="Left" Height="38" Padding="22,0"
                        Foreground="White" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="#1A55DD" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Save Configuration" FontFamily="Segoe UI" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

            </StackPanel>
        </Border>

        <!-- Info card -->
        <Border Grid.Row="4" CornerRadius="12" Padding="18,14" BorderThickness="1">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#4A9AEE"
                           VerticalAlignment="Top" Margin="0,2,14,0"/>
                <StackPanel>
                    <TextBlock Text="How it works" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" FontSize="11.5" TextWrapping="Wrap">
                        Each path is stored independently in the <Bold>app_config</Bold> database table and shared across all machines.
                        Photos, attachments and mark list documents each have their own dedicated folder.
                        A local JSON backup is kept for offline starts.
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

    </Grid>
    </ScrollViewer>
</Page>
