<Page x:Class="CollegeManagementWPF.Views.AssignPathPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>

    <Grid Margin="32,24,32,32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Banner -->
        <Border Grid.Row="0" CornerRadius="14" Padding="24,18" BorderThickness="1">
            <Border.BorderBrush><SolidColorBrush Color="#0D9488"/></Border.BorderBrush>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0A2A2A" Offset="0"/>
                    <GradientStop Color="#051515" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <StackPanel Orientation="Horizontal">
                <Border Width="50" Height="50" CornerRadius="12" Background="#0D3A3A" Margin="0,0,16,0">
                    <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="26"
                               Foreground="#2DD4BF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Assign Storage Path" FontSize="20" FontWeight="Bold"
                               Foreground="White" FontFamily="Segoe UI"/>
                    <TextBlock Text="Set the base folder where student photos and attachments are stored."
                               FontSize="11.5" Foreground="#5EAAA8" FontFamily="Segoe UI" Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Current paths info -->
        <Border Grid.Row="2" CornerRadius="12" Padding="22,18" BorderThickness="1">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel>
                <TextBlock Text="Current Storage Configuration" FontSize="13" FontWeight="Bold"
                           Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" Margin="0,0,0,16"/>

                <!-- Base path -->
                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource RegLabelFg}"
                           FontFamily="Segoe UI" Margin="0,0,0,4">Base Storage Path</TextBlock>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Padding="12,0" Height="38" BorderThickness="1">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Border.Background><DynamicResource ResourceKey="RegInputBg"/></Border.Background>
                        <TextBlock x:Name="TxtBasePath" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{DynamicResource RegInputFg}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="2" Click="BtnBrowse_Click" Height="38" Padding="16,0" Cursor="Hand"
                            FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Background="#0D6B6B" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Browse" FontFamily="Segoe UI" FontWeight="Bold"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Preview -->
                <Border CornerRadius="8" Padding="14,12" Margin="0,0,0,16" BorderThickness="1">
                    <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                    <Border.Background>
                        <SolidColorBrush x:Name="PreviewBg" Color="#050B16"/>
                    </Border.Background>
                    <StackPanel>
                        <TextBlock Text="Resolved Paths" FontSize="11" FontWeight="SemiBold"
                                   Foreground="#2DD4BF" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Photos: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtPhotosPath" FontSize="11" Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="#60A5FA" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Attachments: " FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtAttachPath" FontSize="11" Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Mark List base path -->
                <TextBlock FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource RegLabelFg}"
                           FontFamily="Segoe UI" Margin="0,0,0,4">Mark List Documents Path</TextBlock>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" CornerRadius="8" Padding="12,0" Height="38" BorderThickness="1">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Border.Background><DynamicResource ResourceKey="RegInputBg"/></Border.Background>
                        <TextBlock x:Name="TxtMlBasePath" VerticalAlignment="Center" FontFamily="Segoe UI" FontSize="12"
                                   Foreground="{DynamicResource RegInputFg}" TextTrimming="CharacterEllipsis"/>
                    </Border>
                    <Button Grid.Column="2" Click="BtnBrowseMl_Click" Height="38" Padding="16,0" Cursor="Hand"
                            FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="White" BorderThickness="0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="8" Background="#0D6B6B" Padding="{TemplateBinding Padding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xED25;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                   Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Browse" FontFamily="Segoe UI" FontWeight="Bold"
                                                   FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- Save button -->
                <Button Click="BtnSave_Click" HorizontalAlignment="Left" Height="38" Padding="20,0"
                        FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" Foreground="White" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="#1A55DD" Padding="{TemplateBinding Padding}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="Save Configuration" FontFamily="Segoe UI" FontWeight="Bold"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <!-- Info card -->
        <Border Grid.Row="4" CornerRadius="12" Padding="18,14" BorderThickness="1">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="#4A9AEE"
                           VerticalAlignment="Top" Margin="0,2,14,0"/>
                <StackPanel>
                    <TextBlock Text="How it works" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" Margin="0,0,0,6"/>
                    <TextBlock Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" FontSize="11.5" TextWrapping="Wrap">
                        Set the base folder and the app will automatically create <Bold>photos/</Bold> and <Bold>attachments/</Bold> subfolders inside it.
                        When registering students, files are copied to these folders. The path is saved per-machine so different
                        computers can use different locations (e.g. a shared network drive).
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Page>
