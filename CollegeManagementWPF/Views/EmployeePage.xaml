<Page x:Class="CollegeManagementWPF.Views.EmployeePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:local="clr-namespace:CollegeManagementWPF.Views">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop x:Name="PageBg1" Color="#0D1B3E" Offset="0"/>
            <GradientStop x:Name="PageBg2" Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>
    <Page.Resources>
        <local:AddOneConverter x:Key="AddOneConverter"/>
        <Style x:Key="FL" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="10.5"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Foreground"   Value="{DynamicResource RegLabelFg}"/>
            <Setter Property="FontFamily"   Value="Segoe UI"/>
            <Setter Property="Margin"       Value="0,0,0,3"/>
        </Style>
        <Style x:Key="WI" TargetType="TextBox">
            <Setter Property="Background"           Value="{DynamicResource RegInputBg}"/>
            <Setter Property="Foreground"           Value="{DynamicResource RegInputFg}"/>
            <Setter Property="BorderBrush"          Value="{DynamicResource RegInputBorder}"/>
            <Setter Property="BorderThickness"      Value="1"/>
            <Setter Property="FontSize"             Value="12"/>
            <Setter Property="FontFamily"           Value="Segoe UI"/>
            <Setter Property="Height"               Value="34"/>
            <Setter Property="Padding"              Value="8,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AB" TargetType="Button">
            <Setter Property="Height"          Value="36"/>
            <Setter Property="FontSize"        Value="12.5"/>
            <Setter Property="FontWeight"      Value="Bold"/>
            <Setter Property="FontFamily"      Value="Segoe UI"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="20,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TC" TargetType="TextBlock">
            <Setter Property="Foreground"       Value="{DynamicResource TableRowFg}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin"           Value="8,0"/>
        </Style>
    </Page.Resources>

    <!--
        Layout: 3 rows
        Row 0 (Auto)  = Form fields + photo panel side by side
        Row 1 (Auto)  = Horizontal filter bar
        Row 2 (*)     = Data table — fills all remaining space
    -->
    <Grid Margin="14,8,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════
             ROW 0: Form (left) + Photo card (right)
             ══════════════════════════════════════════ -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="190"/>
            </Grid.ColumnDefinitions>

            <!-- Form fields + action buttons -->
            <Grid Grid.Column="0" Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row of fields 1 -->
                <Border Grid.Row="0" CornerRadius="10" Padding="14,11" Margin="0,0,0,5" BorderThickness="1">
                    <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                    <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                    <UniformGrid Rows="1" Columns="4">
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Employee ID"   Style="{StaticResource FL}"/><TextBox x:Name="TxtEmpID"  Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Department ID" Style="{StaticResource FL}"/><TextBox x:Name="TxtDeptID" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="First Name"    Style="{StaticResource FL}"/><TextBox x:Name="TxtFName"  Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel>                  <TextBlock Text="Middle Name"   Style="{StaticResource FL}"/><TextBox x:Name="TxtMName"  Style="{StaticResource WI}"/></StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Row of fields 2 -->
                <Border Grid.Row="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,5" BorderThickness="1">
                    <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                    <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                    <UniformGrid Rows="1" Columns="4">
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Last Name"     Style="{StaticResource FL}"/><TextBox x:Name="TxtLName"     Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Sex"           Style="{StaticResource FL}"/><TextBox x:Name="TxtSex"       Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Birth Date"    Style="{StaticResource FL}"/><TextBox x:Name="TxtBirthDate" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel>                  <TextBlock Text="Employee Date" Style="{StaticResource FL}"/><TextBox x:Name="TxtEmpDate"   Style="{StaticResource WI}"/></StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Row of fields 3 -->
                <Border Grid.Row="2" CornerRadius="10" Padding="14,11" Margin="0,0,0,8" BorderThickness="1">
                    <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                    <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                    <UniformGrid Rows="1" Columns="4">
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Level"              Style="{StaticResource FL}"/><TextBox x:Name="TxtLevel"        Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Qualification Title" Style="{StaticResource FL}"/><TextBox x:Name="TxtQualification" Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel Margin="0,0,10,0"><TextBlock Text="Mobile Number"       Style="{StaticResource FL}"/><TextBox x:Name="TxtMobile"       Style="{StaticResource WI}"/></StackPanel>
                        <StackPanel>
                            <TextBlock Text="Photo File" Style="{StaticResource FL}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtPhoto" Grid.Column="0" Style="{StaticResource WI}" IsReadOnly="True" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Click="BtnBrowsePhoto_Click" Width="34" Height="34" Cursor="Hand" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="7" Background="{DynamicResource RegBrowseBg}">
                                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </UniformGrid>
                </Border>

                <!-- Action buttons -->
                <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="BtnSave"   Content="Save"   Click="BtnSave_Click"   Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background></Button>
                    <Button x:Name="BtnUpdate" Content="Update" Click="BtnUpdate_Click" Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#1A9944"/></Button.Background></Button>
                    <Button x:Name="BtnDelete" Content="Delete" Click="BtnDelete_Click" Style="{StaticResource AB}" Margin="0,0,8,0"><Button.Background><SolidColorBrush Color="#CC2222"/></Button.Background></Button>
                    <Button x:Name="BtnClear"  Content="Clear"  Click="BtnClear_Click"  Style="{StaticResource AB}" Foreground="#5577AA">
                        <Button.Background><SolidColorBrush Color="Transparent"/></Button.Background>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Photo card (right) -->
            <Border Grid.Column="1" CornerRadius="12" Padding="12,16" BorderThickness="1">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border CornerRadius="10" Width="140" Height="168" ClipToBounds="True"
                            BorderThickness="2" Margin="0,0,0,10">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Grid>
                            <StackPanel x:Name="PhotoPlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="52"
                                           Foreground="#2A4A7A" HorizontalAlignment="Center"/>
                                <TextBlock Text="No Photo" FontSize="11" FontFamily="Segoe UI"
                                           Foreground="#3A5A8A" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <Image x:Name="ImgPhoto" Stretch="UniformToFill" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TxtEmpName" Text="" FontSize="11.5" FontWeight="Bold"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="160"
                               Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ══════════════════════════════════════════
             ROW 1: Horizontal filter bar
             ══════════════════════════════════════════ -->
        <Border Grid.Row="1" CornerRadius="10" Padding="14,10" Margin="0,0,0,6" BorderThickness="1">
            <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
            <Border.Background><DynamicResource ResourceKey="RegCardInnerBg"/></Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter label -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="&#xE71C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="#4A9AEE" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="Filter" FontSize="12" FontWeight="Bold"
                               Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Employee ID" Style="{StaticResource FL}"/>
                    <TextBox x:Name="TxtFEmpID" Style="{StaticResource WI}" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="First Name" Style="{StaticResource FL}"/>
                    <TextBox x:Name="TxtFFName" Style="{StaticResource WI}" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Father Name" Style="{StaticResource FL}"/>
                    <TextBox x:Name="TxtFMName" Style="{StaticResource WI}" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="G/Father Name" Style="{StaticResource FL}"/>
                    <TextBox x:Name="TxtFLName" Style="{StaticResource WI}" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <TextBlock Text="Dept ID" Style="{StaticResource FL}"/>
                    <TextBox x:Name="TxtFDept" Style="{StaticResource WI}" Height="30"/>
                </StackPanel>
                <StackPanel Grid.Column="6" Margin="0,0,8,0">
                    <TextBlock Text="Level" Style="{StaticResource FL}"/>
                    <TextBox x:Name="TxtFLevel" Style="{StaticResource WI}" Height="30"/>
                </StackPanel>

                <!-- Filter / Reset buttons -->
                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="Filter" Click="BtnFilter_Click"
                            Style="{StaticResource AB}" Height="30" Padding="12,0" Margin="0,0,6,0">
                        <Button.Background><SolidColorBrush Color="#1A55DD"/></Button.Background>
                    </Button>
                    <Button Content="Reset" Click="BtnFilterReset_Click"
                            Style="{StaticResource AB}" Height="30" Padding="10,0" Foreground="#5577AA">
                        <Button.Background><SolidColorBrush Color="Transparent"/></Button.Background>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════
             ROW 2: Data table — fills remaining space
             ══════════════════════════════════════════ -->
        <Grid Grid.Row="2">
            <Border CornerRadius="10" BorderThickness="1" ClipToBounds="True">
                <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                <DataGrid x:Name="Grid1"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          Background="Transparent"
                          RowBackground="{DynamicResource TableRowBg}"
                          AlternatingRowBackground="{DynamicResource TableRowBg}"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource RegInputBorder}"
                          ColumnHeaderHeight="36" RowHeight="30"
                          FontSize="11.5" FontFamily="Segoe UI"
                          Foreground="{DynamicResource TableRowFg}"
                          SelectionChanged="Grid1_SelectionChanged">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background"       Value="{DynamicResource TableHeaderBg}"/>
                            <Setter Property="Foreground"       Value="{DynamicResource TableHeaderFg}"/>
                            <Setter Property="FontWeight"       Value="Bold"/>
                            <Setter Property="Padding"          Value="8,0"/>
                            <Setter Property="BorderThickness"  Value="0,0,0,1"/>
                            <Setter Property="BorderBrush"      Value="{DynamicResource RegInputBorder}"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Foreground" Value="{DynamicResource TableRowFg}"/>
                            <Setter Property="Background" Value="{DynamicResource TableRowBg}"/>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#1A3A6B"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource TableRowHoverBg}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Foreground"      Value="{DynamicResource TableRowFg}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Background="{TemplateBinding Background}" BorderThickness="0" Padding="0">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="#"             Binding="{Binding _RowNo}"              Width="38"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Emp ID"        Binding="{Binding employee_id}"         Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Dept"          Binding="{Binding department_id}"       Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="First Name"    Binding="{Binding first_name}"          Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Mid Name"      Binding="{Binding middle_name}"         Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Last Name"     Binding="{Binding last_name}"           Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Sex"           Binding="{Binding sex}"                 Width="50"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Level"         Binding="{Binding level}"               Width="*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Qualification" Binding="{Binding qualification_title}" Width="2*"/>
                        <DataGridTextColumn ElementStyle="{StaticResource TC}" Header="Mobile"        Binding="{Binding mobile_number}"       Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Loading overlay -->
            <Border x:Name="LoadingOverlay" Visibility="Collapsed" CornerRadius="10">
                <Border.Background><SolidColorBrush Color="#A0000000"/></Border.Background>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" Width="44" Height="44"/>
                    <TextBlock Text="Loading..." Foreground="White" FontSize="13"
                               FontFamily="Segoe UI" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
