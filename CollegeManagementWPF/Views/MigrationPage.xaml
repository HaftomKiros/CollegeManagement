<Page x:Class="CollegeManagementWPF.Views.MigrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0D1B3E" Offset="0"/><GradientStop Color="#07101E" Offset="1"/>
        </LinearGradientBrush>
    </Page.Background>
    <StackPanel Margin="40,30" MaxWidth="700">
        <TextBlock Text="BLOB to File Path Migration" FontSize="20" FontWeight="Bold" Foreground="White" FontFamily="Segoe UI" Margin="0,0,0,8"/>
        <TextBlock Text="Copies all photo and attachment BLOBs from the database to local files and saves the file paths back to the database. BLOBs are NOT deleted." FontSize="12" Foreground="#5577AA" FontFamily="Segoe UI" TextWrapping="Wrap" Margin="0,0,0,20"/>
        <TextBlock Text="Storage Folder" FontSize="11" FontWeight="SemiBold" Foreground="#5577AA" FontFamily="Segoe UI" Margin="0,0,0,5"/>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="TxtFolder" Grid.Column="0" Background="#0F1E36" Foreground="White" BorderBrush="#1E3A6A" BorderThickness="1" FontSize="12" FontFamily="Segoe UI" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
            <Button Grid.Column="2" Content="Browse Folder" Height="34" FontSize="12" FontFamily="Segoe UI" Foreground="White" Cursor="Hand" Padding="14,0" BorderThickness="0" Click="BrowseFolder_Click">
                <Button.Background><SolidColorBrush Color="#1A3A6B"/></Button.Background>
            </Button>
        </Grid>
        <TextBlock x:Name="TxtStatus" Text="Ready to migrate." FontSize="12" Foreground="#5577AA" FontFamily="Segoe UI" Margin="0,0,0,8"/>
        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,0,0,16" BorderThickness="0"/>
        <Button x:Name="BtnRun" Content="Run Migration" Height="42" FontSize="14" FontWeight="Bold" FontFamily="Segoe UI" Foreground="White" Cursor="Hand" Padding="28,0" BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,20" Click="BtnRun_Click">
            <Button.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#2255DD" Offset="0"/><GradientStop Color="#1144BB" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
        </Button>
        <Border CornerRadius="8" BorderThickness="1" BorderBrush="#1A3A6B" Padding="12" MaxHeight="360">
            <Border.Background><SolidColorBrush Color="#060C18"/></Border.Background>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0" Foreground="#7799BB" FontFamily="Consolas" FontSize="11" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Text="Migration log will appear here..."/>
            </ScrollViewer>
        </Border>
    </StackPanel>
</Page>
