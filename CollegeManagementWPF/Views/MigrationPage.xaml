<Page x:Class="CollegeManagementWPF.Views.MigrationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Page.Background>
        <DynamicResource ResourceKey="PageBgBrush"/>
    </Page.Background>

    <Grid Margin="30,20,30,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page title -->
        <TextBlock Grid.Row="0" Text="BLOB to File Path Migration" FontSize="20" FontWeight="Bold"
                   Foreground="{DynamicResource RegInputFg}" FontFamily="Segoe UI" Margin="0,0,0,16"/>

        <!-- Tabs -->
        <TabControl Grid.Row="1" Background="Transparent" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource RegLabelFg}"/>
                    <Setter Property="FontFamily" Value="Segoe UI"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="18,8"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="bd" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"
                                        CornerRadius="8,8,0,0" Background="Transparent" BorderThickness="0">
                                    <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#1A3A6B"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#112240"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <!-- ══ Tab 1: Student Profile ══ -->
            <TabItem Header="&#xE716;  Student Profile">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,20,0,0" MaxWidth="680">
                    <TextBlock Text="Migrates student photo and attachment BLOBs to local files, saves file paths, then removes BLOB columns."
                               FontSize="12" Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="Storage Folder" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource RegInputBorder}">
                            <Border.Background><DynamicResource ResourceKey="RegInputBg"/></Border.Background>
                            <TextBox x:Name="TxtFolder" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource RegInputFg}" FontSize="12" FontFamily="Segoe UI"
                                     Height="34" Padding="10,0" VerticalContentAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="2" Content="Browse Folder" Height="34" FontSize="12" FontFamily="Segoe UI"
                                Foreground="White" Cursor="Hand" Padding="14,0" BorderThickness="0" Click="BrowseFolder_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="7" Background="#1A3A6B" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="TxtStatus" Text="Ready." FontSize="12"
                               Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Margin="0,0,0,16" BorderThickness="0"/>

                    <Button x:Name="BtnRun" Content="Run Migration" Height="42" FontSize="14" FontWeight="Bold"
                            FontFamily="Segoe UI" Foreground="White" Cursor="Hand" Padding="28,0"
                            BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,20" Click="BtnRun_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2255DD" Offset="0"/>
                                            <GradientStop Color="#1144BB" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                                    <Trigger Property="IsPressed"   Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border CornerRadius="10" BorderThickness="1" Padding="12" MaxHeight="320">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource RegLabelFg}" FontFamily="Consolas" FontSize="11"
                                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     Text="Migration log will appear here..."/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ══ Tab 2: Mark List Documents ══ -->
            <TabItem Header="&#xE8A5;  Mark List Documents">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,20,0,0" MaxWidth="680">
                    <TextBlock Text="Exports mark list document BLOBs from mark_list_docs to local files, saves file paths, then removes the doc_file BLOB column."
                               FontSize="12" Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI"
                               TextWrapping="Wrap" Margin="0,0,0,20"/>

                    <TextBlock Text="Storage Folder" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource RegInputBorder}">
                            <Border.Background><DynamicResource ResourceKey="RegInputBg"/></Border.Background>
                            <TextBox x:Name="TxtMlFolder" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource RegInputFg}" FontSize="12" FontFamily="Segoe UI"
                                     Height="34" Padding="10,0" VerticalContentAlignment="Center"/>
                        </Border>
                        <Button Grid.Column="2" Content="Browse Folder" Height="34" FontSize="12" FontFamily="Segoe UI"
                                Foreground="White" Cursor="Hand" Padding="14,0" BorderThickness="0" Click="BrowseMlFolder_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="7" Background="#1A3A6B" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.82"/></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <TextBlock x:Name="TxtMlStatus" Text="Ready." FontSize="12"
                               Foreground="{DynamicResource RegLabelFg}" FontFamily="Segoe UI" Margin="0,0,0,8"/>
                    <ProgressBar x:Name="MlProgress" Height="8" Minimum="0" Maximum="100" Value="0"
                                 Margin="0,0,0,16" BorderThickness="0"/>

                    <Button x:Name="BtnMlRun" Content="Run Migration" Height="42" FontSize="14" FontWeight="Bold"
                            FontFamily="Segoe UI" Foreground="White" Cursor="Hand" Padding="28,0"
                            BorderThickness="0" HorizontalAlignment="Left" Margin="0,0,0,20" Click="BtnMlRun_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="9" Padding="{TemplateBinding Padding}">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#1A6A3A" Offset="0"/>
                                            <GradientStop Color="#0D4A28" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.85"/></Trigger>
                                    <Trigger Property="IsPressed"   Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.65"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border CornerRadius="10" BorderThickness="1" Padding="12" MaxHeight="320">
                        <Border.BorderBrush><DynamicResource ResourceKey="RegInputBorder"/></Border.BorderBrush>
                        <Border.Background><DynamicResource ResourceKey="RegTableBg"/></Border.Background>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBox x:Name="TxtMlLog" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource RegLabelFg}" FontFamily="Consolas" FontSize="11"
                                     IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                     Text="Migration log will appear here..."/>
                        </ScrollViewer>
                    </Border>
                </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Page>
